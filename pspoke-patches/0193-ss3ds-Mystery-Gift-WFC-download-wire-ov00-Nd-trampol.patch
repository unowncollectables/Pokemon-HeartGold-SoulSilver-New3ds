From c7034c2882a21a34db53d897a8b4f73f410836d8 Mon Sep 17 00:00:00 2001
From: platinum3ds <local@box>
Date: Mon, 2 Nov 2026 03:16:32 -0500
Subject: [PATCH] ss3ds: Mystery Gift WFC download - wire ov00 Nd trampolines
 (run 106)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Drop the 10 Missing() traps for ov00_021ED1F0/ED308/ED428/EC938/ED3F4/ED3AC/ED444/ED388/ED354/ECEC0
(ARM DWC_Nd / inet helpers used by ov74_02236AE0). Real wrappers live in the platform
ss3ds_dwcstub.c. Force plain http:// for the Nd DLS URL and fill the empty SDK_PORT
DWCi_NdCancelAsync in compile-network.py (CLEAN network rebuild).
---
 port/native-probe/compile-network.py          | 20 +++++++++++++++++++
 .../nitromain-perf/missing.c                  | 14 ++++---------
 2 files changed, 24 insertions(+), 10 deletions(-)

diff --git a/port/native-probe/compile-network.py b/port/native-probe/compile-network.py
index 2863690..c9572d6 100644
--- a/port/native-probe/compile-network.py
+++ b/port/native-probe/compile-network.py
@@ -118,6 +118,26 @@ if 'ss3ds 0184' not in _a4_src:
     if _a4_src.count(_a4_old) != 1:
         sys.exit('ss3ds 0184: dwc_auth.c acctcreate success text not found exactly once; refusing to build without the login follow-up')
     _a4_path.write_text(_a4_src.replace(_a4_old, _a4_new, 1))
+# ss3ds 0193: Mystery Gift Nd download. (1) Force plain http:// for the DLS URL - revival
+# servers terminate or accept HTTP the same way NAS does; Nitro SSL over 3DS sockets is unproven
+# and GTS already uses plain HTTP. (2) Fill the empty SDK_PORT DWCi_NdCancelAsync body so cancel
+# returns TRUE instead of falling off the end. CLEAN BUILD REQUIRED (network phase).
+_nd_path = b / 'libntrdwc/libraries/base/src/dwc_nd.c'
+_nd_src = _nd_path.read_text()
+if 'ss3ds 0193' not in _nd_src:
+    _nd_old0 = 'if (strlen(dwcndcnt->svlresult.svlhost) + strlen("https:///download") > SVLHOSTNAMEMAX) {'
+    _nd_new0 = 'if (strlen(dwcndcnt->svlresult.svlhost) + strlen("http:///download") > SVLHOSTNAMEMAX) { /* ss3ds 0193 */'
+    _nd_old1 = 'OS_SNPrintf(url, SVLHOSTNAMEMAX + 1, "https://%s/download", dwcndcnt->svlresult.svlhost);'
+    _nd_new1 = 'OS_SNPrintf(url, SVLHOSTNAMEMAX + 1, "http://%s/download", dwcndcnt->svlresult.svlhost); /* ss3ds 0193: plain HTTP like NAS */'
+    if _nd_src.count(_nd_old1) != 1 or _nd_src.count(_nd_old0) != 1:
+        sys.exit('ss3ds 0193: expected dwc_nd.c https download URL text not found exactly once; refusing to build with HTTPS Nd')
+    _nd_src = _nd_src.replace(_nd_old0, _nd_new0, 1).replace(_nd_old1, _nd_new1, 1)
+    _nd_oldc = "#ifdef SDK_PORT\nBOOL DWCi_NdCancelAsync( void ) {\n\n}\n#endif"
+    _nd_newc = "#ifdef SDK_PORT\nBOOL DWCi_NdCancelAsync( void ) {\n    /* ss3ds 0193: empty body fell off the end; report cancel accepted so MG teardown proceeds */\n    return TRUE;\n}\n#endif"
+    if _nd_src.count(_nd_oldc) != 1:
+        sys.exit('ss3ds 0193: expected empty SDK_PORT DWCi_NdCancelAsync not found exactly once')
+    _nd_src = _nd_src.replace(_nd_oldc, _nd_newc, 1)
+    _nd_path.write_text(_nd_src)
 def comp(p):
  name=str(p.relative_to(b)).replace('/','__');f=flags+['-I'+str(p.parent),'-I'+str(p.parent.parent/'include'),'-I'+str(p.parent.parent),'-include','pspkernel.h']
  if p.name=='network.c':f+=['-include','sys/socket.h','-include','netinet/in.h','-include','arpa/inet.h']
diff --git a/port/soulsilver-native-core/nitromain-perf/missing.c b/port/soulsilver-native-core/nitromain-perf/missing.c
index e30a02b..a1dd8f3 100644
--- a/port/soulsilver-native-core/nitromain-perf/missing.c
+++ b/port/soulsilver-native-core/nitromain-perf/missing.c
@@ -716,15 +716,9 @@ int CRYPTO_VerifySignature(const void *d,int len,const void *sig,const void *key
 unsigned short SVC_GetCRC16(unsigned v,const void *d,unsigned n){const unsigned char *p=d;while(n--){v^=*p++;for(int k=0;k<8;k++)v=(v&1)?(v>>1)^0xA001:v>>1;}return (unsigned short)v;}
 /* NitroSDK CRYPTO_RC4Init: i@0, j@1, S[256]@4. */
 void CRYPTO_RC4Init(void *ctx,const void *key,unsigned klen){unsigned char *c=ctx,*s=c+4;const unsigned char *k=key;for(int i=0;i<256;i++)s[i]=i;unsigned j=0;for(int i=0;i<256;i++){unsigned char t=s[i];j=(j+t+k[i%klen])&0xff;s[i]=s[j];s[j]=t;}c[0]=0;c[1]=0;}
-__attribute__((noreturn)) void ov00_021ED388(void){Missing("ov00_021ED388");}
-__attribute__((noreturn)) void ov00_021ED308(void){Missing("ov00_021ED308");}
-__attribute__((noreturn)) void ov00_021ED428(void){Missing("ov00_021ED428");}
-__attribute__((noreturn)) void ov00_021EC938(void){Missing("ov00_021EC938");}
-__attribute__((noreturn)) void ov00_021ED3F4(void){Missing("ov00_021ED3F4");}
-__attribute__((noreturn)) void ov00_021ED3AC(void){Missing("ov00_021ED3AC");}
-__attribute__((noreturn)) void ov00_021ED444(void){Missing("ov00_021ED444");}
-__attribute__((noreturn)) void ov00_021ED1F0(void){Missing("ov00_021ED1F0");}
-__attribute__((noreturn)) void ov00_021ED354(void){Missing("ov00_021ED354");}
-__attribute__((noreturn)) void ov00_021ECEC0(void){Missing("ov00_021ECEC0");}
+/* ss3ds 0193: ov00_021ED388/ED308/ED428/EC938/ED3F4/ED3AC/ED444/ED1F0/ED354/ECEC0
+ * removed - real DWC_Nd* / CleanupInetAsync / NASLoginAbort wrappers live in
+ * soulsilver3ds/platform/ss3ds_dwcstub.c (Mystery Gift WFC download path).
+ */
 /* SS3DS run 105/116: Mystery Gift moveCursorFunc. PlaySE on move; gSS_MG_CursorDiag kept for patch compatibility. */
 int gSS_MG_CursorDiag;
