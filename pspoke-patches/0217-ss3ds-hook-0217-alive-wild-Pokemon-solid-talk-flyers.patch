+// 0217 ambient flyer (decoration only, never battles, nothing saved): every 30-70 s outdoors a bird for this area, time of day
+// and weather crosses the screen high up with its shadow below. Rarely shiny (1/2048, needs the shiny sparkle row) and very
+// rarely a legendary (Ho-Oh by day, Lugia at night, 1/4096). Both unlock an achievement.
+static void SS3DS_BirdKill(SS3DSWildState *S, const char *why) {
+    if (S->birdOn) {
+        P3DS_WildFree(7);
+        PSPNativeMemLog("[WILD] flyer species %d gone (%s)", S->birdSp, why);
+    }
+    S->birdOn = 0;
+}
+
+static void SS3DS_BirdTick(FieldSystem *fieldSystem, SS3DSWildState *S, int px, int pz) {
+    if (!P3DS_WildVisCfg(5)) {
+        SS3DS_BirdKill(S, "off");
+        return;
+    }
+    if (FieldSystem_TaskIsRunning(fieldSystem)) {
+        return; // menus, scripts: it waits in the air
+    }
+    if (S->birdOn) {
+        S->birdT++;
+        if (S->birdT == SS3DS_BIRD_FRAMES / 2 && (S->birdBig || P3DS_WildVisCfg(4))) {
+            PlayCry(S->birdSp, 0);
+        }
+        if (S->birdT >= SS3DS_BIRD_FRAMES) {
+            SS3DS_BirdKill(S, "flew off");
+        }
+        return;
+    }
+    if (S->birdNext > 0) {
+        S->birdNext--;
+        return;
+    }
+    S->birdNext = 900 + (int)SS3DS_WildRand(S, 1200);
+    int legend = 0, sp = SS3DS_WildBirdPick(fieldSystem, &legend);
+    if (sp <= 0) {
+        return;
+    }
+    int shiny = !legend && P3DS_WildVisCfg(2) && SS3DS_WildRand(S, 2048) == 0;
+    int spr = P3DS_FollowerSprite(sp, 0, 0);
+    int w = spr >= 0 ? P3DS_WildLoad(7, spr, shiny) : 0;
+    if (!w) {
+        PSPNativeMemLog("[WILD] no flyer sprite for species %d", sp);
+        return;
+    }
+    S->birdOn = 1;
+    S->birdSp = sp;
+    S->birdW = w;
+    S->birdT = 0;
+    S->birdShiny = shiny;
+    S->birdBig = legend;
+    S->birdDir = SS3DS_WildRand(S, 2) ? 3 : 2;
+    S->birdX = px + (S->birdDir == 3 ? -18 : 18);
+    S->birdZ = pz - 5 + (int)SS3DS_WildRand(S, 8);
+    PSPNativeMemLog("[WILD] flyer species %d%s%s heading %s at z %d", sp, shiny ? " SHINY" : "", legend ? " LEGENDARY" : "", S->birdDir == 3 ? "east" : "west", S->birdZ);
+    if (legend) {
+        P3DS_Toast("A LEGENDARY POKEMON FLEW OVERHEAD!");
+        P3DS_AchSky(1);
+    } else if (shiny) {
+        PlaySE(SEQ_SE_DP_KIRAKIRA);
+        P3DS_Toast("A SHINY POKEMON FLEW PAST!");
+        P3DS_AchSky(0);
+    }
+}
