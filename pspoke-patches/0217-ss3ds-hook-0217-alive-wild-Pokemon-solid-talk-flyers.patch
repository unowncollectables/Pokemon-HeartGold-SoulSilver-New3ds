+// 0217 the flyer: high above the ground, flapping (fast frame swap), its shadow on the ground below, fading in and out at the ends
+static void SS3DS_BirdDraw(SS3DSWildState *S, fx32 py, u32 anim) {
+    const MtxFx43 *cm = &NNS_G3dGlb.cameraMtx;
+    VecFx32 c, v;
+    int sz = S->birdW, t = S->birdT, sgn = S->birdDir == 3 ? 1 : -1;
+    fx32 run = 36 * 16 * FX32_ONE / SS3DS_BIRD_FRAMES; // 36 tiles over the whole flight
+    c.x = (S->birdX * 16 + 8) * FX32_ONE + sgn * run * t;
+    c.z = (S->birdZ * 16 + 8) * FX32_ONE;
+    G3_MtxMode(GX_MTXMODE_POSITION_VECTOR);
+    c.y = py + FX32_ONE / 2;
+    SS3DS_WildShadow(cm, &c, S->birdBig ? sz : sz / 2);
+    int bob = (int)((anim >> 2) & 7);
+    bob = bob < 4 ? bob : 8 - bob;
+    c.y = py + (sz / 2 + (S->birdBig ? 40 : 28) + bob) * FX32_ONE;
+    v = SS3DS_WildCam(cm, &c);
+    int fr = S->birdDir * 2 + ((anim >> 2) & 1);
+    fx16 hw = (fx16)((sz / 2) * FX16_ONE / 16);
+    int edge = t < SS3DS_BIRD_FRAMES - t ? t : SS3DS_BIRD_FRAMES - t;
+    int fade = edge >= 20 ? 31 : 3 + edge * 28 / 20;
+    G3_PushMtx();
+    G3_Identity();
+    G3_Translate(v.x, v.y, v.z);
+    G3_Scale(16 * FX32_ONE, 16 * FX32_ONE, 16 * FX32_ONE);
+    G3_PolygonAttr(GX_LIGHTMASK_NONE, GX_POLYGONMODE_MODULATE, GX_CULL_NONE, fade < 31 ? 4 : 0, fade, GX_POLYGON_ATTR_MISC_FOG);
+    G3_TexImageParam(GX_TEXFMT_PLTT16, GX_TEXGEN_NONE, sz == 64 ? GX_TEXSIZE_S64 : GX_TEXSIZE_S32, sz == 64 ? GX_TEXSIZE_T64 : GX_TEXSIZE_T32,
+        GX_TEXREPEAT_NONE, GX_TEXFLIP_NONE, GX_TEXPLTTCOLOR0_TRNS, 0x7FFF8 - 7 * 8);
+    G3_TexPlttBase(0x1FF00 + fr * 16, GX_TEXFMT_PLTT16);
+    G3_Color(GX_RGB(31, 31, 31));
+    G3_Begin(GX_BEGIN_QUADS);
+    G3_TexCoord(0, 0);
+    G3_Vtx(-hw, hw, 0);
+    G3_TexCoord(0, sz * FX32_ONE);
+    G3_Vtx(-hw, -hw, 0);
+    G3_TexCoord(sz * FX32_ONE, sz * FX32_ONE);
+    G3_Vtx(hw, -hw, 0);
+    G3_TexCoord(sz * FX32_ONE, 0);
+    G3_Vtx(hw, hw, 0);
+    G3_End();
+    G3_PopMtx(1);
+}
+
