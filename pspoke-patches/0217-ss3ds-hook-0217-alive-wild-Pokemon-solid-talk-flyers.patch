@@ -0,0 +1,59 @@
+#!/usr/bin/env python3
+"""ss3ds 0217: alive wild Pokemon call sites (Settings > Battle "Alive wild Pokemon", default OFF). The logic is in the 0110
+block (encounter_check.c SS3DS_WildSolid / SS3DS_WildTalk, fieldmap_native.c flyers); this adds the three call sites once:
+  field_control.c FieldInput_Update   a visible one in the way drops the walk keys (solid; pushing on it asks for its battle)
+  field_control.c FieldInput_Process  A facing one, a bump or a charge starts its battle (before NPC / sign interaction)
+  encounter_check.c                   a forced (visible) battle uses the visible one's land / water type, so it also starts when
+                                      the player stands on a tile with no encounters next to it
+Idempotent ('SS3DS 0217')."""
+import sys
+
+TAG = 'SS3DS 0217'
+
+
+def edit(path, pairs):
+    s = open(path).read()
+    if TAG in s:
+        return
+    for old, new in pairs:
+        if s.count(old) != 1:
+            sys.exit('0217_wildalive: anchor not found exactly once in %s: %r' % (path, old[:80]))
+        s = s.replace(old, new)
+    open(path, 'w').write(s)
+    print('0217_wildalive: %s hooked' % path)
+
+
+which = sys.argv[1] if len(sys.argv) > 1 else 'all'
+if which in ('all', 'control'):
+    edit('src/field/field_control.c', [
+        ('void FieldInput_Update(FieldInput *fieldInput, FieldSystem *fieldSystem, u16 newKeys, u16 heldKeys) {\n',
+         'extern int SS3DS_WildSolid(FieldSystem *fieldSystem, int dir); // SS3DS 0217 alive wild Pokemon (0110 block in encounter_check.c)\n'
+         'extern int SS3DS_WildTalk(FieldSystem *fieldSystem, int interact);\n\n'
+         'void FieldInput_Update(FieldInput *fieldInput, FieldSystem *fieldSystem, u16 newKeys, u16 heldKeys) {\n'),
+        ('    fieldInput->playerDir = sub_0205DD94(fieldSystem->playerAvatar, newKeys, heldKeys);\n}\n',
+         '    fieldInput->playerDir = sub_0205DD94(fieldSystem->playerAvatar, newKeys, heldKeys);\n'
+         '    if (SS3DS_WildSolid(fieldSystem, fieldInput->playerDir)) { // SS3DS 0217: a visible wild Pokemon is in the way\n'
+         '        fieldInput->newKeys &= ~PAD_PLUS_KEY_MASK;\n'
+         '        fieldInput->heldKeys &= ~PAD_PLUS_KEY_MASK;\n'
+         '        fieldInput->playerDir = DIR_NONE;\n'
+         '    }\n}\n'),
+        ('        && FieldSystem_CheckSign(fieldSystem) == TRUE) {\n        return 1;\n    }\n\n    if (fieldInput->interact) {\n',
+         '        && FieldSystem_CheckSign(fieldSystem) == TRUE) {\n        return 1;\n    }\n\n'
+         '    if (SS3DS_WildTalk(fieldSystem, fieldInput->interact)) { // SS3DS 0217: A / bump / charge -> its battle\n'
+         '        fieldSystem->lastTouchMenuInput = 0;\n'
+         '        return 1;\n'
+         '    }\n\n'
+         '    if (fieldInput->interact) {\n'),
+    ])
+if which in ('all', 'enc'):
+    edit('src/field/encounter_check.c', [
+        ('    encounterRate = FieldSystem_GetTileEncounterTypeAndRate(fieldSystem, metatileBehavior, &encounterType);\n    if (encounterRate == 0) {\n        return FALSE;\n    }\n    FieldSystem_UpdateTurnFrameCounter(fieldSystem);\n',
+         '    encounterRate = FieldSystem_GetTileEncounterTypeAndRate(fieldSystem, metatileBehavior, &encounterType);\n'
+         '    if (sSS3DS_Force) { // SS3DS 0217: the visible one decides land or water (the player may stand next to it, off the grass)\n'
+         '        encounterType = sSS3DS_ForceKind == 2 ? ENCOUNTER_TYPE_SURFING : ENCOUNTER_TYPE_LAND;\n'
+         '        if (encounterRate == 0) {\n'
+         '            encounterRate = 1;\n'
+         '        }\n'
+         '    }\n'
+         '    if (encounterRate == 0) {\n        return FALSE;\n    }\n    FieldSystem_UpdateTurnFrameCounter(fieldSystem);\n'),
+    ])
