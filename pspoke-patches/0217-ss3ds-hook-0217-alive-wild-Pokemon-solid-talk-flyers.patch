+# ss3ds 0217: alive wild Pokemon call sites (after 0110, which refreshes the logic block). Not fatal: without it the
+# "Alive wild Pokemon" row only adds the flyers; visible ones stay walk-through as before. Optional: logs "skipped", never stops the build.
+if ! (cd "$C" && python3 "$ROOT/scripts/ss3ds_hooks.d/0217_wildalive.py" && bash rebuild_game_object.sh src/field/field_control.c field__field_control.o 1 && bash rebuild_game_object.sh src/field/encounter_check.c field__encounter_check.o 2); then
+  log "ss3ds 0217 wildalive hook skipped (see message above); visible wild Pokemon stay walk-through"
+fi
