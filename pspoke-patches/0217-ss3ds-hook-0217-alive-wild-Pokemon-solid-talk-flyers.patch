+// ---- 0217 alive wild Pokemon (Settings > Battle "Alive wild Pokemon"): solid, A / bump / chase starts the battle, ambient flyers ----
+static int sSS3DS_Bump;
+static int SS3DS_WildAliveOn(void) {
+    return P3DS_WildVisCfg(0) && P3DS_WildVisCfg(5);
+}
+
+// slot of a visible Pokemon on the tile next to the player in direction dir (0 up/north, 1 down, 2 left, 3 right), or -1
+static int SS3DS_WildFaceSlot(FieldSystem *fieldSystem, int dir) {
+    SS3DSWildState *S = P3DS_WildMem();
+    if (S->magic != SS3DS_WILD_MAGIC || dir < 0 || dir > 3) {
+        return -1;
+    }
+    int tx = PlayerAvatar_GetXCoord(fieldSystem->playerAvatar) + (dir == 2 ? -1 : dir == 3 ? 1 : 0);
+    int tz = PlayerAvatar_GetZCoord(fieldSystem->playerAvatar) + (dir == 0 ? -1 : dir == 1 ? 1 : 0);
+    for (int i = 0; i < SS3DS_WILD_MAX; i++) {
+        SS3DSWildMon *m = &S->m[i];
+        if (m->on && !m->battle && ((m->x == tx && m->z == tz) || (m->t < 16 && m->fx == tx && m->fz == tz))) {
+            return i;
+        }
+    }
+    return -1;
+}
+
+// Called every field frame from FieldInput_Update with the direction the player wants to walk. 1 = a visible Pokemon is in the way:
+// the caller drops the direction keys, so the player just stands facing it. Pushing against it for 20 frames asks for its battle.
+int SS3DS_WildSolid(FieldSystem *fieldSystem, int dir) {
+    if (!SS3DS_WildAliveOn() || dir < 0 || dir != (int)PlayerAvatar_GetFacingDirection(fieldSystem->playerAvatar)) {
+        sSS3DS_Bump = 0;
+        return 0;
+    }
+    int i = SS3DS_WildFaceSlot(fieldSystem, dir);
+    if (i < 0) {
+        sSS3DS_Bump = 0;
+        return 0;
+    }
+    SS3DSWildState *S = P3DS_WildMem();
+    if (++sSS3DS_Bump == 1) {
+        PSPNativeMemLog("[WILD] slot %d species %d is in the way (solid)", i + 1, S->m[i].sp);
+    }
+    if (sSS3DS_Bump >= 20 && !S->talk && S->cool <= 0) {
+        S->talk = i + 1;
+    }
+    return 1;
+}
+
+// Called from FieldInput_Process (player at rest, no task) with whether A was pressed. 1 = a battle with a visible one started.
+int SS3DS_WildTalk(FieldSystem *fieldSystem, int interact) {
+    SS3DSWildState *S = P3DS_WildMem();
+    if (S->magic != SS3DS_WILD_MAGIC) {
+        return 0;
+    }
+    int i = -1;
+    if (!SS3DS_WildAliveOn() || SS3DS_WildBlocked(fieldSystem)) {
+        S->talk = 0;
+        return 0;
+    }
+    if (S->talk) {
+        i = S->talk - 1;
+        S->talk = 0;
+        if (i < 0 || i >= SS3DS_WILD_MAX || !S->m[i].on || S->m[i].battle) {
+            return 0;
+        }
+        int dx = S->m[i].x - PlayerAvatar_GetXCoord(fieldSystem->playerAvatar), dz = S->m[i].z - PlayerAvatar_GetZCoord(fieldSystem->playerAvatar);
+        if ((dx < 0 ? -dx : dx) + (dz < 0 ? -dz : dz) > 1) {
+            return 0; // it was chasing but the player has walked off
+        }
+    } else if (interact && S->cool <= 0) {
+        i = SS3DS_WildFaceSlot(fieldSystem, (int)PlayerAvatar_GetFacingDirection(fieldSystem->playerAvatar));
+    }
+    if (i < 0) {
+        return 0;
+    }
+    SS3DSWildMon *m = &S->m[i];
+    PSPNativeMemLog("[WILD] talk/bump slot %d species %d lv %d%s -> battle", i + 1, m->sp, m->lv, m->shiny ? " SHINY" : "");
+    P3DS_WildBattleResult = -1;
+    BOOL ret = SS3DS_WildEncounter(fieldSystem, m->sp, m->lv, m->shiny, m->roamer, m->kind);
+    sSS3DS_Bump = 0;
+    if (ret) {
+        m->battle = 1;
+        return 1;
+    }
+    S->cool = 90; // repel / roamer gone: do not ask again every frame
+    PSPNativeMemLog("[WILD] no battle (repel / no wild battles / roamer gone), slot %d stays", i + 1);
+    return 0;
+}
+
+// Ambient flyer for this area, time of day and weather (decoration). 0 = none here (indoors, caves). *legend = 1 for a rare legendary.
+int SS3DS_WildBirdPick(FieldSystem *fieldSystem, int *legend) {
+    static const u16 kFly[] = { 16, 17, 18, 21, 22, 41, 42, 163, 164, 169, 198, 225, 227, 276, 277, 278, 279, 333, 334, 396, 397, 398 };
+    static const u16 kDay[] = { 16, 16, 17, 21, 21, 22, 276, 18 };
+    static const u16 kNight[] = { 163, 163, 164, 198, 198, 42 };
+    *legend = 0;
+    if (!MapHeader_IsOutdoors(fieldSystem->location->mapId)) {
+        return 0;
+    }
+    int weather = LocalFieldData_GetWeatherType(Save_LocalFieldData_Get(fieldSystem->saveData));
+    TIMEOFDAY tod = GF_RTC_GetTimeOfDay();
+    int night = tod == RTC_TIMEOFDAY_NITE || tod == RTC_TIMEOFDAY_LATE;
+    if (weather <= WEATHER_THUNDERSTORM && LCRandRange(4096) == 0) { // as rare as a shiny flyover-wise
+        *legend = 1;
+        return night ? SPECIES_LUGIA : SPECIES_HO_OH;
+    }
+    // a flyer from this area's own grass table (the real morning/day/night and swarm tables) first
+    for (int tries = 0; tries < 6; tries++) {
+        int sp, lv;
+        if (!SS3DS_WildPick(fieldSystem, 0, &sp, &lv)) {
+            break;
+        }
+        for (u32 k = 0; k < sizeof(kFly) / sizeof(kFly[0]); k++) {
+            if (kFly[k] == sp) {
+                return sp;
+            }
+        }
+    }
+    if (weather >= WEATHER_RAIN && weather <= WEATHER_THUNDERSTORM) {
+        return LCRandRange(2) ? SPECIES_WINGULL : SPECIES_PELIPPER;
+    }
+    if (weather == WEATHER_SNOW || weather == WEATHER_BLIZZARD) {
+        return SPECIES_DELIBIRD;
+    }
+    return night ? kNight[LCRandRange(sizeof(kNight) / sizeof(kNight[0]))] : kDay[LCRandRange(sizeof(kDay) / sizeof(kDay[0]))];
+}
+
