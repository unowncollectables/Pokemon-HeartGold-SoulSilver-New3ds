 scripts/ss3ds_hooks.d/0110_wildvis.py | 151 ++++++++++++++++++++++----
 1 file changed, 132 insertions(+), 19 deletions(-)

diff --git a/scripts/ss3ds_hooks.d/0110_wildvis.py b/scripts/ss3ds_hooks.d/0110_wildvis.py
index 5cdc551..5d65d4e 100644
--- a/scripts/ss3ds_hooks.d/0110_wildvis.py
+++ b/scripts/ss3ds_hooks.d/0110_wildvis.py
@@ -13,12 +13,13 @@ import os
 import sys
 
 COMMON = r'''
-/* SS3DS-WILD-BEGIN v4 (0110/0111/0217/0218: everything between BEGIN and END is replaced by the hook on every build) */
+/* SS3DS-WILD-BEGIN v5 (0110/0111/0217/0218/0223: everything between BEGIN and END is replaced by the hook on every build) */
 /* SS3DS 0110 visible wild Pokemon. The state lives in the port (P3DS_WildMem, platform g3soft.cpp) so it survives the
    field overlay being unloaded for menus, the bag and battles. Nothing here is saved. Same layout in fieldmap.c and
    encounter_check.c. */
 #define SS3DS_WILD_MAX 6
-/* 0218: sleep (night nap, Zz), leader (slot+1 of the one it travels with), fight (squabble frames left), big (rare huge one), splash */
+/* 0218: sleep (night nap, Zz), leader (slot+1 of the one it travels with), fight (squabble frames left), big (rare huge one), splash;
+   0223: spare = 1 for an ambient town Pokemon (decoration only: not solid, no battle, no cries, no "!") */
 typedef struct { s16 on, sp, lv, x, z, fx, fz, t, timer, dir, w, shiny, kind, mood, noticed, hop, roamer, grass, battle, skip, bang, pad, sleep, leader, fight, big, splash, spare; } SS3DSWildMon;
 /* 0217 alive wild: talk = slot+1 of a visible one that asked for its battle (A / bump / chase), cool = frames before the next ask;
    bird* = the ambient flyer (decoration only, texture slot 7): species, sprite width, frame, start tile, direction (2 west, 3 east), shiny, big (legend) */
@@ -63,6 +64,77 @@ int SS3DS_WildBlockedMap(FieldSystem *fieldSystem) {
     return SS3DS_WildBlocked(fieldSystem) || !MapHeader_HasWildEncounters(fieldSystem->location->mapId);
 }
 
+// ---- 0223 lively towns (Settings > Battle "Alive wild Pokemon" = ON + TOWNS): ambient Pokemon in outdoor maps with no wild table
+// (towns and cities). Same sprites and behaviour as the visible wild ones (wander, nap, hop, pairs, curious, shy) but decoration only:
+// never solid, never a battle (SS3DSWildMon.spare != 0). Nothing is saved.
+BOOL sub_020548C0(FieldSystem *fieldSystem, int x, int z); // terrain collision bit of a tile (TRUE = blocked)
+int SS3DS_TownMap(FieldSystem *fieldSystem) {
+    u32 mapId = fieldSystem->location->mapId;
+    return MapHeader_IsOutdoors(mapId) && !MapHeader_HasWildEncounters(mapId) && !SS3DS_WildBlocked(fieldSystem);
+}
+
+// 0 = not for a Pokemon, 1 = open ground (| 4 = grass), 2 = water. Never a tile an NPC / the player stands on, doors, warps, stairs.
+int SS3DS_TownTile(FieldSystem *fieldSystem, int x, int z) {
+    if (fieldSystem->mapObjectManager != NULL && MapObjectManager_GetFirstObjectWithXAndZ(fieldSystem->mapObjectManager, x, z, TRUE) != NULL) {
+        return 0;
+    }
+    u8 behavior = GetMetatileBehavior(fieldSystem, x, z);
+    if (behavior == 0xFF) {
+        return 0; // off the map data
+    }
+    if (MetatileBehavior_IsSurfableWater(behavior)) {
+        return 2;
+    }
+    if (sub_020548C0(fieldSystem, x, z)) {
+        return 0; // walls, fences, trees, houses
+    }
+    if (behavior == 0) {
+        return 1;
+    }
+    if (MetatileBehavior_CanGenerateWalkingEncounters(behavior)) {
+        return 1 | ((MetatileBehavior_IsTallGrass(behavior) || MetatileBehavior_IsVeryTallGrass(behavior)) ? 4 : 0);
+    }
+    return 0;
+}
+
+// Who hangs around: per town and time of day (species numbers; repeats are the weights). rnd is the caller's own random number,
+// so the game's RNG is not touched. 0 = none.
+int SS3DS_TownPick(FieldSystem *fieldSystem, int water, int night, u32 rnd) {
+    static const u16 kDay[] = { 19, 16, 161, 187, 183, 19 };                // Rattata Pidgey Sentret Hoppip Marill
+    static const u16 kNight[] = { 19, 163, 163, 198 };                      // Rattata Hoothoot Murkrow
+    static const u16 kWater[] = { 129, 129, 54, 60 };                       // Magikarp Psyduck Poliwag
+    static const u16 kNBDay[] = { 161, 161, 19, 16, 187, 183 };             // New Bark: Sentret
+    static const u16 kNBNight[] = { 163, 163, 19, 161 };
+    static const u16 kNBWater[] = { 72, 129, 118, 183, 129 };               // Tentacool Magikarp Goldeen Marill
+    static const u16 kGRDay[] = { 52, 52, 19, 16, 209, 209, 25, 133 };      // Goldenrod: Meowth Snubbull, a Pikachu, rarely an Eevee
+    static const u16 kGRNight[] = { 52, 163, 198, 19, 19, 163 };
+    static const u16 kECDay[] = { 19, 19, 16, 161, 58, 37 };                // Ecruteak: Growlithe Vulpix
+    static const u16 kECNight[] = { 92, 92, 200, 163, 198, 19 };            // Gastly Misdreavus Hoothoot Murkrow
+    const u16 *t = water ? kWater : night ? kNight : kDay;
+    u32 n = water ? sizeof(kWater) / 2 : night ? sizeof(kNight) / 2 : sizeof(kDay) / 2;
+    switch (fieldSystem->location->mapId) {
+    case MAP_NEW_BARK:
+        t = water ? kNBWater : night ? kNBNight : kNBDay;
+        n = water ? sizeof(kNBWater) / 2 : night ? sizeof(kNBNight) / 2 : sizeof(kNBDay) / 2;
+        break;
+    case MAP_GOLDENROD:
+        if (!water) {
+            t = night ? kGRNight : kGRDay;
+            n = night ? sizeof(kGRNight) / 2 : sizeof(kGRDay) / 2;
+        }
+        break;
+    case MAP_ECRUTEAK:
+        if (!water) {
+            t = night ? kECNight : kECDay;
+            n = night ? sizeof(kECNight) / 2 : sizeof(kECDay) / 2;
+        }
+        break;
+    default:
+        break;
+    }
+    return t[rnd % n];
+}
+
 // The same slot tables the random encounter uses: time of day, swarm and radio replacements for land, swarm for surf.
