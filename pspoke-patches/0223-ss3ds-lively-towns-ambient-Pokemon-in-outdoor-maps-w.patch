     SS3DS_BirdTick(fieldSystem, S, px, pz); // 0217: flyers also cross towns (maps with no wild table)
     // Menus, the bike, scripts: they stay where they are and stay drawn, they just wait
-    if (FieldSystem_TaskIsRunning(fieldSystem) || SS3DS_WildBlockedMap(fieldSystem)) {
+    // 0223 lively towns: outdoor maps with no wild table get ambient Pokemon (Alive wild Pokemon = ON + TOWNS)
