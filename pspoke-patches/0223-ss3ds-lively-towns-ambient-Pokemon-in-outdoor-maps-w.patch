         }
     }
@@ -321,6 +393,9 @@ extern int SS3DS_WildRoamer(FieldSystem *fieldSystem, int *species, int *level);
 extern int SS3DS_WildBirdPick(FieldSystem *fieldSystem, int *legend);
 extern void P3DS_AchSky(int legend);
 extern int SS3DS_WildEnv(FieldSystem *fieldSystem);
+extern int SS3DS_TownMap(FieldSystem *fieldSystem);
+extern int SS3DS_TownTile(FieldSystem *fieldSystem, int x, int z);
+extern int SS3DS_TownPick(FieldSystem *fieldSystem, int water, int night, u32 rnd);
 extern volatile int P3DS_RunLast; /* 0218: platform ss3ds_glue.c, 1 = the player's last step started as a run */
 extern int P3DS_FollowerSprite(int species, int form, int female);
 extern int P3DS_WildLoad(int slot, int spr, int shiny);
@@ -328,6 +403,11 @@ extern void P3DS_Toast(const char *text);
 extern void PlayCry(u16 species, u8 form);
 extern void PlaySE(u16 sndseq);
 
+static int sSS3DS_TownMode; // 0223: this frame's tick runs the lively-towns rules (set in SS3DS_WildTick)
+static int SS3DS_Tile(FieldSystem *fieldSystem, int x, int z) {
+    return sSS3DS_TownMode ? SS3DS_TownTile(fieldSystem, x, z) : SS3DS_WildTileKind(fieldSystem, x, z);
+}
+
 static u32 SS3DS_WildRand(SS3DSWildState *S, u32 n) {
     S->rng = S->rng * 1103515245u + 12345u;
     return n ? (S->rng >> 8) % n : 0;
@@ -468,7 +548,20 @@ static void SS3DS_WildTick(FieldSystem *fieldSystem) {
