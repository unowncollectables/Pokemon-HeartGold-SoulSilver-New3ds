diff --git a/scripts/ss3ds_hooks.d/0251_pokewalker.py b/scripts/ss3ds_hooks.d/0251_pokewalker.py
new file mode 100644
index 0000000..845439e
--- /dev/null
+++ b/scripts/ss3ds_hooks.d/0251_pokewalker.py
@@ -0,0 +1,16 @@
+from pathlib import Path
+
+path = Path("src/application/main_menu/main_menu.c")
+source = path.read_text()
+marker = "/* SS3DS 0251 */"
+if marker not in source:
+    anchor = "        if (P3DS_MenuGreyUnsupportedCfg() && MainMenu_IsUnsupportedOn3DS(sel0197)) {"
+    if source.count(anchor) != 1:
+        raise SystemExit("0251 Pokewalker menu anchor not found exactly once")
+    source = source.replace(anchor, """        extern int SS3DS_PwalkerCanLaunch(void); /* SS3DS 0251 */
+        if (sel0197 == APPOPTION_POKEWALKER && !SS3DS_PwalkerCanLaunch()) {
+            PlaySE(SEQ_SE_DP_BOX03);
+            return FALSE;
+        }
+""" + anchor)
+    path.write_text(source)
