+#!/usr/bin/env bash
+# The original app is enabled explicitly and only with an accessible IR chip.
+if ! (cd "$C" && python3 "$ROOT/scripts/ss3ds_hooks.d/0251_pokewalker.py" &&
+    bash rebuild_game_object.sh src/application/main_menu/main_menu.c application__main_menu__main_menu.o 74); then
+    log "ss3ds 0251 Pokewalker menu NOT applied"
+fi
