+#define SS3DS_BERRY_ROLL 24
+#define SS3DS_BERRY_SNIFF 72
+#define SS3DS_BERRY_END 88
+
+static int SS3DS_TownBerryStart(FieldSystem *fieldSystem, SS3DSWildState *S, int i, int j) {
+    SS3DSWildMon *m = &S->m[i], *o = &S->m[j];
+    int x = (m->x + o->x) / 2, z = (m->z + o->z) / 2;
+    int first = SS3DS_WildRand(S, 4);
+    for (int turn = 0; turn < 4; turn++) {
+        int d = (first + turn) % 4;
+        int dx = d == 2 ? -1 : d == 3 ? 1 : 0, dz = d == 0 ? -1 : d == 1 ? 1 : 0;
+        int sx = x + dx, sz = z + dz;
+        if ((sx == m->x && sz == m->z) || (sx == o->x && sz == o->z)) {
+            continue;
+        }
+        int start = SS3DS_TownTile(fieldSystem, sx, sz);
+        int finish = SS3DS_TownTile(fieldSystem, sx + dx, sz + dz);
+        if (start == 1 && finish == 1 && !SS3DS_WildCrowded(S, -1, sx + dx, sz + dz)) {
+            S->berryA = i + 1;
+            S->berryB = j + 1;
+            S->berryX = sx;
+            S->berryZ = sz;
+            S->berryDir = d;
+            S->berryT = 0;
+            PSPNativeMemLog("[WILD] slots %d and %d chase a berry", i + 1, j + 1);
+            return 1;
+        }
+    }
+    return 0;
+}
+
+static void SS3DS_TownBerryChase(FieldSystem *fieldSystem, SS3DSWildState *S, int i) {
+    SS3DSWildMon *m = &S->m[i];
+    int d = S->berryDir, dx = d == 2 ? -1 : d == 3 ? 1 : 0, dz = d == 0 ? -1 : d == 1 ? 1 : 0;
+    int bx = S->berryX + dx, bz = S->berryZ + dz;
+    int x = bx - m->x, z = bz - m->z;
+    int ax = x < 0 ? -x : x, az = z < 0 ? -z : z;
+    int horizontal = x < 0 ? 2 : 3, vertical = z < 0 ? 0 : 1;
+    m->dir = ax > az ? horizontal : vertical;
+    if (S->berryT < SS3DS_BERRY_ROLL || S->berryT >= SS3DS_BERRY_SNIFF || m->t < 16) {
+        return;
+    }
+    if (ax + az <= 1) {
+        S->berryT = SS3DS_BERRY_SNIFF;
+        m->hop = 6;
+        PSPNativeMemLog("[WILD] slot %d sniffs the berry", i + 1);
+        return;
+    }
+    for (int n = 0; n < 2; n++) {
+        int tryDir = n ? (ax > az ? vertical : horizontal) : m->dir;
+        if (tryDir < 2 ? az == 0 : ax == 0) {
+            continue;
+        }
+        int nx = m->x + (tryDir == 2 ? -1 : tryDir == 3 ? 1 : 0);
+        int nz = m->z + (tryDir == 0 ? -1 : tryDir == 1 ? 1 : 0);
+        if (SS3DS_TownTile(fieldSystem, nx, nz) == 1 && !SS3DS_WildCrowded(S, i, nx, nz)) {
+            m->dir = tryDir;
+            m->fx = m->x;
+            m->fz = m->z;
+            m->x = nx;
+            m->z = nz;
+            m->t = 0;
+            m->grass = 0;
+            m->tracks = 0;
+            return;
+        }
+    }
+}
