+// A small rolling berry, drawn as a camera-facing prop. It has no inventory or collision state.
+static void SS3DS_TownBerryDraw(FieldSystem *fieldSystem, SS3DSWildState *S, fx32 py) {
+    const MtxFx43 *cm = &NNS_G3dGlb.cameraMtx;
+    int d = S->berryDir, dx = d == 2 ? -1 : d == 3 ? 1 : 0, dz = d == 0 ? -1 : d == 1 ? 1 : 0;
+    int roll = S->berryT < SS3DS_BERRY_ROLL ? S->berryT : SS3DS_BERRY_ROLL;
+    fx32 offset = roll * 16 * FX32_ONE / SS3DS_BERRY_ROLL;
+    VecFx32 c;
+    c.x = (S->berryX * 16 + 8) * FX32_ONE + dx * offset;
+    c.z = (S->berryZ * 16 + 8) * FX32_ONE + dz * offset;
+    c.y = SS3DS_WildGroundY(fieldSystem, c.x, c.z, py) + 3 * FX32_ONE;
+    VecFx32 v = SS3DS_WildCam(cm, &c);
+    fx16 u = FX16_ONE / 16;
+    G3_MtxMode(GX_MTXMODE_POSITION_VECTOR);
+    G3_PushMtx();
+    G3_Identity();
+    G3_Translate(v.x, v.y, v.z);
+    G3_Scale(16 * FX32_ONE, 16 * FX32_ONE, 16 * FX32_ONE);
+    G3_PolygonAttr(GX_LIGHTMASK_NONE, GX_POLYGONMODE_MODULATE, GX_CULL_NONE, 0, 31, GX_POLYGON_ATTR_MISC_FOG);
+    G3_TexImageParam(GX_TEXFMT_NONE, GX_TEXGEN_NONE, GX_TEXSIZE_S8, GX_TEXSIZE_T8, GX_TEXREPEAT_NONE, GX_TEXFLIP_NONE, GX_TEXPLTTCOLOR0_USE, 0);
+    G3_Begin(GX_BEGIN_QUADS);
+    G3_Color(GX_RGB(25, 6, 4));
+    G3_Vtx(0, 2 * u, 0);
+    G3_Vtx(-2 * u, 0, 0);
+    G3_Vtx(0, -2 * u, 0);
+    G3_Vtx(2 * u, 0, 0);
+    G3_End();
+    G3_Begin(GX_BEGIN_TRIANGLES);
+    G3_Color(GX_RGB(13, 23, 5));
+    G3_Vtx(0, u, u);
+    G3_Vtx(((roll / 4) & 1 ? -2 : 2) * u, 3 * u, u);
+    G3_Vtx(u, 2 * u, u);
+    G3_End();
+    G3_Color(GX_RGB(31, 31, 31));
+    G3_PopMtx(1);
+}
