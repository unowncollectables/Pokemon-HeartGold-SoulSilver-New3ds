 extern volatile int P3DS_WildBattleResult; /* winFlag of the last battle (encounter.c hook), -1 = none yet */
@@ -79,7 +79,7 @@ int Field_GetWarpEventAtXYPos(const FieldSystem *fieldSystem, int x, int z);
