+#define SS3DS_WILD_MAGIC 0x57494C38u /* 'WIL8': weather effects and berry play */
+typedef char SS3DSWildStateFits[sizeof(SS3DSWildState) <= 576 ? 1 : -1]; /* P3DS_WildMemV2 is 144 words */
+extern void *P3DS_WildMemV2(void);
