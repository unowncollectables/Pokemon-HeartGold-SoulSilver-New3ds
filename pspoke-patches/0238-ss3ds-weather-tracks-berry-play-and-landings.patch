+#define SS3DS_BIRD_MID (SS3DS_BIRD_FRAMES / 2)
+#define SS3DS_BIRD_REST 60
+#define SS3DS_BIRD_GLIDE 26
+
+static int SS3DS_BirdAirTime(SS3DSWildState *S) {
+    int t = S->birdT;
+    if (S->birdPerch && t > SS3DS_BIRD_MID) {
+        t = t > SS3DS_BIRD_MID + SS3DS_BIRD_REST ? t - SS3DS_BIRD_REST : SS3DS_BIRD_MID;
+    }
+    return t;
+}
+
+static int SS3DS_BirdAltitude(SS3DSWildState *S, int t, int bob) {
+    int height = S->birdLow ? 28 : S->birdBig ? 88 : 72;
+    int mid = t - SS3DS_BIRD_MID;
+    int dist = mid < 0 ? -mid : mid;
+    if (S->birdPerch && dist < SS3DS_BIRD_GLIDE) {
+        return (height + bob) * dist / SS3DS_BIRD_GLIDE;
+    }
+    return height + bob;
+}
