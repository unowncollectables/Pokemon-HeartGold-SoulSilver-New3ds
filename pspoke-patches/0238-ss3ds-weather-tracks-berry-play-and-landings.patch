     u8 behavior = GetMetatileBehavior(fieldSystem, x, z);
     return behavior != 0xFF && !MetatileBehavior_IsSurfableWater(behavior)
-        && (behavior == 0 || MetatileBehavior_CanGenerateWalkingEncounters(behavior))
+        && (behavior == 0 || MetatileBehavior_IsMud(behavior) || MetatileBehavior_CanGenerateWalkingEncounters(behavior))
