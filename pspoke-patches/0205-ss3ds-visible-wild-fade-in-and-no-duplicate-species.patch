From d525ce7aeced5e9e264dd9164f87b5d03de3d56e Mon Sep 17 00:00:00 2001
From: ss3ds <ss3ds@localhost>
Date: Tue, 3 Nov 2026 18:19:45 +0000
Subject: [PATCH] ss3ds: visible wild Pokemon fade in instead of popping in,
 and avoid duplicate species nearby

---
 scripts/ss3ds_hooks.d/0110_wildvis.py | 27 ++++++++++++++++++++++++---
 1 file changed, 24 insertions(+), 3 deletions(-)

diff --git a/scripts/ss3ds_hooks.d/0110_wildvis.py b/scripts/ss3ds_hooks.d/0110_wildvis.py
index 0c33c45..15a4209 100644
--- a/scripts/ss3ds_hooks.d/0110_wildvis.py
+++ b/scripts/ss3ds_hooks.d/0110_wildvis.py
@@ -270,8 +270,24 @@ static void SS3DS_WildTick(FieldSystem *fieldSystem) {
                     }
                 }
             }
-            if (ro < 0 && !SS3DS_WildPick(fieldSystem, (kind & 3) == 2, &sp, &lv)) {
-                break;
+            if (ro < 0) {
+                // variety: re-roll (up to 4 times) if that species is already standing nearby; same slot rates otherwise
+                for (int rr = 0; rr < 4; rr++) {
+                    if (!SS3DS_WildPick(fieldSystem, (kind & 3) == 2, &sp, &lv)) {
+                        sp = 0;
+                        break;
+                    }
+                    int dup = 0;
+                    for (i = 0; i < SS3DS_WILD_MAX; i++) {
+                        dup |= S->m[i].on && S->m[i].sp == sp;
+                    }
+                    if (!dup) {
+                        break;
+                    }
+                }
+                if (!sp) {
+                    break;
+                }
             }
             for (k = 0; k < SS3DS_WILD_MAX && S->m[k].on; k++) {
             }
@@ -304,6 +320,7 @@ static void SS3DS_WildTick(FieldSystem *fieldSystem) {
             m->hop = 0;
             m->roamer = ro;
             m->battle = m->skip = m->bang = 0;
+            m->pad = 0; // fade-in counter
             PSPNativeMemLog("[WILD] spawn slot %d species %d lv %d at %d,%d %s%s%s mood %d", k + 1, sp, lv, tx, tz, m->kind == 2 ? "water" : "land", shiny ? " SHINY" : "", ro >= 0 ? " ROAMER" : "", m->mood);
             if (shiny) {
                 PlaySE(SEQ_SE_DP_KIRAKIRA);
@@ -317,6 +334,9 @@ static void SS3DS_WildTick(FieldSystem *fieldSystem) {
         if (!m->on) {
             continue;
         }
+        if (m->pad < 20) {
+            m->pad++;
+        }
         if (m->battle) {
             if (P3DS_WildBattleResult < 0) {
                 continue;
@@ -481,7 +501,8 @@ static void SS3DS_WildDrawOne(SS3DSWildMon *m, int slot, fx32 py, u32 anim) {
     G3_Identity();
     G3_Translate(v.x, v.y, v.z);
     G3_Scale(16 * FX32_ONE, 16 * FX32_ONE, 16 * FX32_ONE);
-    G3_PolygonAttr(GX_LIGHTMASK_NONE, GX_POLYGONMODE_MODULATE, GX_CULL_NONE, 0, 31, GX_POLYGON_ATTR_MISC_FOG);
+    int fade = m->pad >= 20 ? 31 : 3 + m->pad * 28 / 20; // fades in over 20 ticks instead of popping in
+    G3_PolygonAttr(GX_LIGHTMASK_NONE, GX_POLYGONMODE_MODULATE, GX_CULL_NONE, fade < 31 ? 3 : 0, fade, GX_POLYGON_ATTR_MISC_FOG);
     G3_TexImageParam(GX_TEXFMT_PLTT16, GX_TEXGEN_NONE, sz == 64 ? GX_TEXSIZE_S64 : GX_TEXSIZE_S32, sz == 64 ? GX_TEXSIZE_T64 : GX_TEXSIZE_T32,
         GX_TEXREPEAT_NONE, GX_TEXFLIP_NONE, GX_TEXPLTTCOLOR0_TRNS, 0x7FFF8 - slot * 8);
     G3_TexPlttBase(0x1FF00 + fr * 16, GX_TEXFMT_PLTT16);
-- 
2.43.0

