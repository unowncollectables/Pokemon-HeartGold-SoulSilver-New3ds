From 9b7d137c3362c96d69e14631c7b1ae2b75cc0988 Mon Sep 17 00:00:00 2001
From: ss3ds <ss3ds@localhost>
Date: Mon, 9 Nov 2026 03:00:42 -0500
Subject: [PATCH] ss3ds: give town Pokemon scenery routines

---
 scripts/ss3ds_hooks.d/0110_wildvis.py | 61 +++++++++++++++++++++------
 1 file changed, 47 insertions(+), 14 deletions(-)

diff --git a/scripts/ss3ds_hooks.d/0110_wildvis.py b/scripts/ss3ds_hooks.d/0110_wildvis.py
index 4f81651..53f742f 100644
--- a/scripts/ss3ds_hooks.d/0110_wildvis.py
+++ b/scripts/ss3ds_hooks.d/0110_wildvis.py
@@ -442,6 +442,26 @@ static int SS3DS_Tile(FieldSystem *fieldSystem, int x, int z) {
     return sSS3DS_TownMode ? SS3DS_TownTile(fieldSystem, x, z) : SS3DS_WildTileKind(fieldSystem, x, z);
 }
 
+BOOL sub_020548C0(FieldSystem *fieldSystem, int x, int z);
+
+// Returns the direction of a scenery feature next to a safe standing tile.
+static int SS3DS_TownScenery(FieldSystem *fieldSystem, int x, int z, int rain) {
+    for (int d = 0; d < 4; d++) {
+        int nx = x + (d == 2 ? -1 : d == 3 ? 1 : 0);
+        int nz = z + (d == 0 ? -1 : d == 1 ? 1 : 0);
+        u8 behavior = GetMetatileBehavior(fieldSystem, nx, nz);
+        if (behavior == 0xFF) {
+            continue;
+        }
+        int water = MetatileBehavior_IsSurfableWater(behavior);
+        if (rain ? !water && sub_020548C0(fieldSystem, nx, nz)
+                 : water || MetatileBehavior_IsTallGrass(behavior) || MetatileBehavior_IsVeryTallGrass(behavior)) {
+            return d;
+        }
+    }
+    return -1;
+}
+
 // Leave a tile between nearby sprites when choosing a step.
 static int SS3DS_WildCrowded(SS3DSWildState *S, int slot, int x, int z) {
     for (int j = 0; j < SS3DS_WILD_MAX; j++) {
@@ -565,8 +585,6 @@ static void SS3DS_BirdKill(SS3DSWildState *S, const char *why) {
     S->birdOn = 0;
 }
 
-BOOL sub_020548C0(FieldSystem *fieldSystem, int x, int z);
-
 static int SS3DS_BirdLaneOpen(FieldSystem *fieldSystem, int px, int z) {
     // Use terrain collision as a proxy for walls and buildings. Leave room to bank.
     for (int x = px - 20; x <= px + 20; x++) {
@@ -729,20 +747,23 @@ static void SS3DS_WildTick(FieldSystem *fieldSystem) {
     }
     if (S->spawnT == 0 && n < mx) {
         S->spawnT = town ? 150 + (int)SS3DS_WildRand(S, 150) : 90 + (int)SS3DS_WildRand(S, 60);
+        int scenic = town && !(env & 2) && SS3DS_WildRand(S, 2) == 0;
         for (int tries = 0; tries < 8; tries++) {
             int dx = (int)SS3DS_WildRand(S, 17) - 8, dz = (int)SS3DS_WildRand(S, 13) - 6;
             if ((dx < 0 ? -dx : dx) + (dz < 0 ? -dz : dz) < 4) {
                 continue;
             }
-            int tx = px + dx, tz = pz + dz, kind = SS3DS_Tile(fieldSystem, tx, tz), busy = 0;
-            if (!(kind & 3) || ((env & 2) && (kind & 3) == 1 && !(kind & 4))) {
+            int tx = px + dx, tz = pz + dz, kind = SS3DS_Tile(fieldSystem, tx, tz);
+            if (!(kind & 3) || SS3DS_WildCrowded(S, -1, tx, tz)) {
                 continue;
             }
-            for (i = 0; i < SS3DS_WILD_MAX; i++) { // 0221: a free tile around each one, so sprites never clump
-                busy |= S->m[i].on && S->m[i].x - tx <= 1 && tx - S->m[i].x <= 1 && S->m[i].z - tz <= 1 && tz - S->m[i].z <= 1;
-            }
-            if (busy) {
-                continue;
+            if ((kind & 3) == 1) {
+                if ((env & 2) && !(kind & 4) && (!town || SS3DS_TownScenery(fieldSystem, tx, tz, 1) < 0)) {
+                    continue;
+                }
+                if (scenic && tries < 4 && !(kind & 4) && SS3DS_TownScenery(fieldSystem, tx, tz, 0) < 0) {
+                    continue;
+                }
             }
             int sp = 0, lv = 0, ro = -1, k;
             if (!town && (kind & 3) == 1 && SS3DS_WildRand(S, 4) == 0) {
@@ -1096,22 +1117,26 @@ static void SS3DS_WildTick(FieldSystem *fieldSystem) {
             d = adx > adz ? (ddx > 0 ? 3 : 2) : (ddz > 0 ? 1 : 0);
             m->timer = 10 + (int)SS3DS_WildRand(S, 8);
         } else if (alive && (env & 2) && m->kind == 1 && !m->big && m->roamer < 0) {
-            if (m->grass) {
-                continue; // wait out the rain in cover
+            if (m->grass || (m->spare && SS3DS_TownScenery(fieldSystem, m->x, m->z, 1) >= 0)) {
+                continue; // pause in grass or beside a wall
             }
             int shelter = -1;
             for (int turn = 0; turn < 4; turn++) {
                 int tryDir = (d + turn) % 4;
                 int x = m->x + (tryDir == 2 ? -1 : tryDir == 3 ? 1 : 0);
                 int z = m->z + (tryDir == 0 ? -1 : tryDir == 1 ? 1 : 0);
-                if ((SS3DS_Tile(fieldSystem, x, z) & 7) == 5 && !SS3DS_WildCrowded(S, i, x, z)) {
+                int tile = SS3DS_Tile(fieldSystem, x, z);
+                if ((tile & 3) == 1 && !SS3DS_WildCrowded(S, i, x, z)
+                    && ((tile & 4) || (m->spare && SS3DS_TownScenery(fieldSystem, x, z, 1) >= 0))) {
                     shelter = tryDir;
-                    break;
+                    if (tile & 4) {
+                        break; // grass takes priority over a wall
+                    }
                 }
             }
             if (shelter >= 0) {
                 d = shelter;
-                PSPNativeMemLog("[WILD] slot %d species %d steps into cover", i + 1, m->sp);
+                PSPNativeMemLog("[WILD] slot %d species %d seeks a rain spot", i + 1, m->sp);
             } else if (dist > 8 && SS3DS_WildRand(S, 4) == 0) {
                 SS3DS_WildKill(S, i, "sheltering from the rain");
                 continue;
@@ -1132,6 +1157,14 @@ static void SS3DS_WildTick(FieldSystem *fieldSystem) {
             } else if (!m->noticed && napHabit && ax + az == 0 && dist > 2 && SS3DS_WildRand(S, 12) < napHabit) {
                 m->sleep = 180 + (int)SS3DS_WildRand(S, 300);
                 continue;
+            } else if (m->spare && m->kind == 1 && !m->noticed && ax + az <= 2
+                && SS3DS_WildRand(S, m->mood == 1 ? 3 : 6) == 0) {
+                int view = SS3DS_TownScenery(fieldSystem, m->x, m->z, 0);
+                if (view >= 0) {
+                    m->dir = view;
+                    m->timer = 90 + (int)SS3DS_WildRand(S, 90);
+                    continue;
+                }
             }
         }
         int nx = m->x + (d == 2 ? -1 : d == 3 ? 1 : 0), nz = m->z + (d == 0 ? -1 : d == 1 ? 1 : 0), kind = SS3DS_Tile(fieldSystem, nx, nz), busy = nx == px && nz == pz;
