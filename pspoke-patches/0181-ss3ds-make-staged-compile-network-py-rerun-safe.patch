From 8d20935785489a171694eb0b71031f2351370278 Mon Sep 17 00:00:00 2001
From: ss3ds <ss3ds@localhost>
Date: Sun, 1 Nov 2026 16:29:07 +0000
Subject: [PATCH] ss3ds: make the staged compile-network.py re-run safe on an
 already built tree

0180 re-ran compile-network.py on Nathan's staged tree, but the script edits the staged libntrdwc sources in place and those
already held earlier edits, so it stopped with 'ss3ds 0167: expected dwc_backup.c text not found'. Before re-running, the new
scripts/ss3ds_nw_idempotent.py rewrites the staged copy so each in-place edit (0172, 0177, 0178, 0179) is skipped when its
result is already present; a pristine tree behaves as before. The re-run is now recorded only after it succeeds
($NW.ss3ds-built), so a failed attempt is retried on the next build instead of being skipped because the copy already matches.
---
 scripts/ss3ds_game.sh          | 10 +++++++---
 scripts/ss3ds_nw_idempotent.py | 29 +++++++++++++++++++++++++++++
 2 files changed, 36 insertions(+), 3 deletions(-)
 create mode 100644 scripts/ss3ds_nw_idempotent.py

diff --git a/scripts/ss3ds_game.sh b/scripts/ss3ds_game.sh
index 2b5e4f3..39c6c4e 100644
--- a/scripts/ss3ds_game.sh
+++ b/scripts/ss3ds_game.sh
@@ -16,13 +16,17 @@ if [ -f "$NW" ] && ! grep -q SDK_BUILD_LINUX "$NW"; then
   log "ss3ds: staged compile-network.py had no SDK_BUILD_LINUX; rebuilding libnetwork-probe.a"
   step network-linux bash -c "cd '$T/native-probe' && python3 compile-network.py"
 fi
-# ss3ds (0180): the staged compile-network.py was only patched in place above, never re-copied, so a pspoke-patch that edits
-# it (0178/0179 DWC AC bypass) never reached an already staged tree. Re-sync it and rebuild libnetwork-probe.a when it differs.
+# ss3ds (0180/0181): the staged compile-network.py was only patched in place above, never re-copied, so a pspoke-patch that
+# edits it (0178/0179 DWC AC bypass) never reached an already staged tree. Re-sync it and rebuild libnetwork-probe.a until one
+# rebuild from the current script succeeded (recorded in $NW.ss3ds-built). The script edits the staged libntrdwc sources in place,
+# so ss3ds_nw_idempotent.py first makes each of those edits skip when it is already applied (0181).
 SRC_NW="$ROOT/port/native-probe/compile-network.py"
-if [ -f "$NW" ] && [ -f "$SRC_NW" ] && ! cmp -s "$SRC_NW" "$NW"; then
+if [ -f "$NW" ] && [ -f "$SRC_NW" ] && ! cmp -s "$SRC_NW" "$NW.ss3ds-built"; then
   cp -f "$SRC_NW" "$NW"
+  python3 "$(dirname "$0")/ss3ds_nw_idempotent.py" "$NW" || die "ss3ds 0181: could not prepare the staged compile-network.py"
   log "ss3ds: staged compile-network.py was stale, re-synced; rebuilding libnetwork-probe.a"
   step network-linux bash -c "cd '$T/native-probe' && python3 compile-network.py"
+  cp -f "$SRC_NW" "$NW.ss3ds-built"
 fi
 C="$T/soulsilver-native-core"; P="$C/nitromain-perf"
 # ss3ds: the staged tree keeps the prepare scripts copied when it was first staged, so a pspoke-patch that changes
diff --git a/scripts/ss3ds_nw_idempotent.py b/scripts/ss3ds_nw_idempotent.py
new file mode 100644
index 0000000..34a58d7
--- /dev/null
+++ b/scripts/ss3ds_nw_idempotent.py
@@ -0,0 +1,29 @@
+#!/usr/bin/env python3
+"""ss3ds (0181): make the staged compile-network.py safe to re-run on an already built tree.
+
+compile-network.py edits the staged libntrdwc sources in place (0172/0167 dwc_backup.c, 0177 dwc_connectinet.c,
+0178/0179 dwc_ac.c) and exits when an anchor is missing. Those files keep earlier edits, so a re-run (0180) stopped
+with "ss3ds 0167: expected dwc_backup.c text not found". This rewrites only the STAGED copy so each edit is skipped
+when its result is already there; on a pristine tree it behaves exactly as before. Fails loudly if an anchor moved."""
+import sys
+path = sys.argv[1]
+s = open(path).read()
+edits = [
+    # 0172: _dwc_replace(old, new) -> skip when the new text is already in the file
+    ("    if old not in _dwc_src:\n",
+     "    if new in _dwc_src:\n        return\n    if old not in _dwc_src:\n"),
+    # 0177: bounded CleanupInet loop
+    ("if _ci_src.count(_ci_old) != 1:\n",
+     "if _ci_new in _ci_src:\n    _ci_old = _ci_new\nelif _ci_src.count(_ci_old) != 1:\n"),
+    # 0178: AC bypass
+    ("if _ac_src.count(_ac_old1) != 1 or _ac_src.count(_ac_old2) != 1:\n",
+     "if 'ss3ds 0178' in _ac_src:\n    _ac_old1 = _ac_new1 = _ac_old2 = _ac_new2 = '\\x00'\nelif _ac_src.count(_ac_old1) != 1 or _ac_src.count(_ac_old2) != 1:\n"),
+    # 0179: one-time marker
+    ("if _ac_src.count(_ac2_old) != 1:\n",
+     "if 'ss3ds 0179' in _ac_src:\n    _ac2_old = _ac2_new = '\\x00'\nelif _ac_src.count(_ac2_old) != 1:\n"),
+]
+for old, new in edits:
+    if s.count(old) != 1:
+        sys.exit("ss3ds 0181: compile-network.py anchor not found exactly once: %r" % old.strip())
+    s = s.replace(old, new, 1)
+open(path, "w").write(s)
-- 
