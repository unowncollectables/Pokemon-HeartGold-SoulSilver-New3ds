From 08166c4998c498fe4642960052c52f85381c470d Mon Sep 17 00:00:00 2001
From: ss3ds <ss3ds@localhost>
Date: Mon, 9 Nov 2026 03:32:31 -0500
Subject: [PATCH] ss3ds: animate scheduled resident doorway transitions

---
 scripts/ss3ds_hooks.d/0110_wildvis.py | 112 ++++++++++++++++++++++++--
 1 file changed, 105 insertions(+), 7 deletions(-)

diff --git a/scripts/ss3ds_hooks.d/0110_wildvis.py b/scripts/ss3ds_hooks.d/0110_wildvis.py
index 2cabcb8..1b34c88 100644
--- a/scripts/ss3ds_hooks.d/0110_wildvis.py
+++ b/scripts/ss3ds_hooks.d/0110_wildvis.py
@@ -13,7 +13,7 @@ import os
 import sys
 
 COMMON = r'''
-/* SS3DS-WILD-BEGIN v14 (0110/0111/0217/0218/0223/0224: everything between BEGIN and END is replaced by the hook on every build) */
+/* SS3DS-WILD-BEGIN v15 (0110/0111/0217/0218/0223/0224: everything between BEGIN and END is replaced by the hook on every build) */
 /* SS3DS 0110 visible wild Pokemon. The state lives in the port (P3DS_WildMemV2, platform g3soft.cpp) so it survives the
    field overlay being unloaded for menus, the bag and battles. Nothing here is saved. Same layout in fieldmap.c and
    encounter_check.c. */
@@ -286,7 +286,7 @@ static int SS3DS_WildFaceSlot(FieldSystem *fieldSystem, int dir) {
     int tz = PlayerAvatar_GetZCoord(fieldSystem->playerAvatar) + (dir == 0 ? -1 : dir == 1 ? 1 : 0);
     for (int i = 0; i < SS3DS_WILD_MAX; i++) {
         SS3DSWildMon *m = &S->m[i];
-        if (m->on && !m->battle && (!m->spare || (P3DS_WildVisCfg(5) >= 2 && m->kind == 1))
+        if (m->on && !m->battle && m->pad >= 0 && (!m->spare || (P3DS_WildVisCfg(5) >= 2 && m->kind == 1))
             && ((m->x == tx && m->z == tz) || (m->t < 16 && m->fx == tx && m->fz == tz))) {
             return i;
         }
@@ -489,6 +489,31 @@ static const SS3DSTownRoutine *SS3DS_TownRoutineForMap(int map, int env, int *in
     return NULL;
 }
 
+// Entrance and exit warp tiles from the matching map event files.
+static int SS3DS_TownRoutineDoor(int map, int env, int *x, int *z, int *side) {
+    static const u16 doors[][6] = {
+        {MAP_GOLDENROD, MAP_GOLDENROD_FLOWER_SHOP, 371, 332, 5, 9},
+        {MAP_VIOLET, MAP_VIOLET_POKEMON_SCHOOL, 495, 257, 6, 11},
+        {MAP_AZALEA, MAP_AZALEA_KURT_HOUSE, 399, 454, 4, 9},
+        {MAP_ECRUTEAK, MAP_ECRUTEAK_DANCE_THEATER, 397, 173, 7, 17},
+    };
+    for (u32 i = 0; i < sizeof(doors) / sizeof(doors[0]); i++) {
+        int indoors = map == doors[i][1];
+        if (indoors || map == doors[i][0]) {
+            int next = indoors ? doors[i][0] : doors[i][1];
+            int nextIndoors;
+            if (env && !SS3DS_TownRoutineForMap(next, env, &nextIndoors)) {
+                return 0;
+            }
+            *x = doors[i][indoors ? 4 : 2];
+            *z = doors[i][indoors ? 5 : 3];
+            *side = indoors ? -1 : 1;
+            return 1;
+        }
+    }
+    return 0;
+}
+
 // Returns the direction of a scenery feature next to a safe standing tile.
 static int SS3DS_TownScenery(FieldSystem *fieldSystem, int x, int z, int rain) {
     for (int d = 0; d < 4; d++) {
@@ -691,6 +716,43 @@ static int SS3DS_WildCoverTick(SS3DSWildMon *m, int loud, int dist, int toward)
     return 1;
 }
 
+// Walk to a legal tile in front of the warp, then fade toward the door.
+static void SS3DS_TownDepart(FieldSystem *fieldSystem, SS3DSWildState *S, int i, int doorX, int doorZ, int side) {
+    SS3DSWildMon *m = &S->m[i];
+    int stageZ = doorZ + 2 * side;
+    if (m->x == doorX && m->z == stageZ) {
+        m->dir = side > 0 ? 0 : 1;
+        m->pad = -16;
+        m->hop = m->bang = m->splash = m->tracks = m->rustle = 0;
+        PSPNativeMemLog("[WILD] resident species %d leaves at door %d,%d", m->sp, doorX, doorZ);
+        return;
+    }
+    int dx = doorX - m->x, dz = stageZ - m->z;
+    int ax = dx < 0 ? -dx : dx, az = dz < 0 ? -dz : dz;
+    int horizontal = dx > 0 ? 3 : 2, vertical = dz > 0 ? 1 : 0;
+    int directions[2] = {ax >= az ? horizontal : vertical, ax >= az ? vertical : horizontal};
+    for (int n = 0; n < 2; n++) {
+        int d = directions[n];
+        if (d < 2 ? !az : !ax) {
+            continue;
+        }
+        int x = m->x + (d == 2 ? -1 : d == 3 ? 1 : 0);
+        int z = m->z + (d == 0 ? -1 : d == 1 ? 1 : 0);
+        int tile = SS3DS_TownTile(fieldSystem, x, z);
+        if ((tile & 3) == 1 && !SS3DS_WildCrowded(S, i, x, z)) {
+            m->dir = d;
+            m->fx = m->x;
+            m->fz = m->z;
+            m->x = x;
+            m->z = z;
+            m->t = 0;
+            m->grass = (tile & 4) != 0;
+            m->tracks = 0;
+            return;
+        }
+    }
+}
+
 static void SS3DS_WildKill(SS3DSWildState *S, int i, const char *why) {
     if (S->m[i].on) {
         SS3DS_WildEndPlay(S, i);
@@ -931,7 +993,9 @@ static void SS3DS_WildTick(FieldSystem *fieldSystem) {
     int env = alive ? SS3DS_WildEnv(fieldSystem) : 0;
     int indoors = 0;
     const SS3DSTownRoutine *routine = alive >= 2 ? SS3DS_TownRoutineForMap(map, env, &indoors) : NULL;
-    int town = alive >= 2 && (SS3DS_TownMap(fieldSystem) || (indoors && routine));
+    int doorX = 0, doorZ = 0, doorSide = 0;
+    int leaving = alive >= 2 && !routine && SS3DS_TownRoutineDoor(map, env, &doorX, &doorZ, &doorSide);
+    int town = alive >= 2 && (SS3DS_TownMap(fieldSystem) || (indoors && (routine || leaving)));
     if (town != sSS3DS_TownMode) {
         PSPNativeMemLog("[WILD] town life %s on map %d", town ? "on" : "off", map);
     }
@@ -1067,8 +1131,24 @@ static void SS3DS_WildTick(FieldSystem *fieldSystem) {
             m->on = 1;
             m->sp = sp;
             m->lv = lv;
-            m->x = m->fx = m->homeX = tx;
-            m->z = m->fz = m->homeZ = tz;
+            m->homeX = tx;
+            m->homeZ = tz;
+            if (!regular && indoors) {
+                int entryX, entryZ, entrySide;
+                if (SS3DS_TownRoutineDoor(map, 0, &entryX, &entryZ, &entrySide)) {
+                    entryZ += 2 * entrySide;
+                    int dx = entryX - px, dz = entryZ - pz;
+                    int entryTile = SS3DS_TownTile(fieldSystem, entryX, entryZ);
+                    if ((dx < 0 ? -dx : dx) + (dz < 0 ? -dz : dz) >= 2
+                        && (entryTile & 3) == 1 && !SS3DS_WildCrowded(S, k, entryX, entryZ)) {
+                        tx = entryX;
+                        tz = entryZ;
+                        kind = entryTile;
+                    }
+                }
+            }
+            m->x = m->fx = tx;
+            m->z = m->fz = tz;
             m->t = 16;
             m->timer = 40 + (int)SS3DS_WildRand(S, 50);
             m->dir = 1;
@@ -1149,6 +1229,12 @@ static void SS3DS_WildTick(FieldSystem *fieldSystem) {
         if (!m->on) {
             continue;
         }
+        if (m->pad < 0) {
+            if (++m->pad == 0) {
+                SS3DS_WildKill(S, i, "entered scheduled doorway");
+            }
+            continue;
+        }
         if (m->pad < 20) {
             m->pad++;
         }
@@ -1224,6 +1310,15 @@ static void SS3DS_WildTick(FieldSystem *fieldSystem) {
             m->t++;
             continue;
         }
+        if (leaving && m->spare == 2 && dist > 1) {
+            SS3DS_WildEndPlay(S, i);
+            m->sleep = 0;
+            if (--m->timer <= 0) {
+                m->timer = 8;
+                SS3DS_TownDepart(fieldSystem, S, i, doorX, doorZ, doorSide);
+            }
+            continue;
+        }
         if (alive) {
             if (!(env & 2) && m->wet && !m->sleep && !m->fight && !m->playWith && m->hop == 0
                 && m->noticed < WILD_STARTLED) {
@@ -1689,6 +1784,9 @@ static void SS3DS_WildDrawOne(FieldSystem *fieldSystem, SS3DSWildMon *m, int slo
     int sz = m->w, hs = m->big ? sz * 3 / 4 : sz / 2; // 0218: a huge one is drawn 1.5x
     c.x = ((m->fx * 16 + 8) * FX32_ONE) + FX_Mul((m->x - m->fx) * 16 * FX32_ONE, tt);
     c.z = ((m->fz * 16 + 8) * FX32_ONE) + FX_Mul((m->z - m->fz) * 16 * FX32_ONE, tt);
+    if (m->pad < 0) {
+        c.z += (m->dir == 0 ? -1 : 1) * (16 + m->pad) * FX32_ONE / 2;
+    }
     py = SS3DS_WildGroundY(fieldSystem, c.x, c.z, py);
     G3_MtxMode(GX_MTXMODE_POSITION_VECTOR);
     if (m->kind == 1 && !m->grass) {
@@ -1707,7 +1805,7 @@ static void SS3DS_WildDrawOne(FieldSystem *fieldSystem, SS3DSWildMon *m, int slo
     if (effects && m->kind == 1 && m->splash > 0) {
         v.x += (m->splash & 2 ? -1 : 1) * FX32_ONE;
     }
-    int moving = m->t < 16, fr = m->sleep ? 2 : m->dir * 2 + ((anim >> (moving ? 3 : 4)) & 1);
+    int moving = m->t < 16 || m->pad < 0, fr = m->sleep ? 2 : m->dir * 2 + ((anim >> (moving ? 3 : 4)) & 1);
     fx16 hw = (fx16)(hs * FX16_ONE / 16);
     // in tall grass the lower 30% is not drawn, so it stands in the grass instead of on top of it
     fx16 by = m->grass && !moving ? (fx16)(-hw + hw * 3 / 5) : (fx16)-hw;
@@ -1723,7 +1821,7 @@ static void SS3DS_WildDrawOne(FieldSystem *fieldSystem, SS3DSWildMon *m, int slo
     G3_Identity();
     G3_Translate(v.x, v.y, v.z);
     G3_Scale(16 * FX32_ONE, 16 * FX32_ONE, 16 * FX32_ONE);
-    int fade = m->pad >= 20 ? 31 : 3 + m->pad * 28 / 20; // fades in over 20 ticks instead of popping in
+    int fade = m->pad < 0 ? -m->pad * 31 / 16 : m->pad >= 20 ? 31 : 3 + m->pad * 28 / 20;
     G3_PolygonAttr(GX_LIGHTMASK_NONE, GX_POLYGONMODE_MODULATE, GX_CULL_NONE, fade < 31 ? 3 : 0, fade, GX_POLYGON_ATTR_MISC_FOG);
     G3_TexImageParam(GX_TEXFMT_PLTT16, GX_TEXGEN_NONE, sz == 64 ? GX_TEXSIZE_S64 : GX_TEXSIZE_S32, sz == 64 ? GX_TEXSIZE_T64 : GX_TEXSIZE_T32,
         GX_TEXREPEAT_NONE, GX_TEXFLIP_NONE, GX_TEXPLTTCOLOR0_TRNS, 0x7FFF8 - slot * 8);
-- 
