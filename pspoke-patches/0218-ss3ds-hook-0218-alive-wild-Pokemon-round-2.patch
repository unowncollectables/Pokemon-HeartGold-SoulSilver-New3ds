+// 0218: two small white "z" marks drifting up beside the head of a napping one
+static void SS3DS_WildZz(fx16 hw, u32 anim) {
+    const fx16 u = FX16_ONE / 16, z = FX16_ONE / 8;
+    G3_TexImageParam(GX_TEXFMT_NONE, GX_TEXGEN_NONE, GX_TEXSIZE_S8, GX_TEXSIZE_T8, GX_TEXREPEAT_NONE, GX_TEXFLIP_NONE, GX_TEXPLTTCOLOR0_USE, 0);
+    G3_Color(GX_RGB(31, 31, 31));
+    for (int k = 0; k < 2; k++) {
+        int ph = (int)((anim >> 2) + k * 8) % 16;
+        fx16 s = (fx16)(u * (k ? 3 : 2)), x0 = (fx16)(hw / 2 + u * (2 + k * 3) + u * ph / 8), y0 = (fx16)(hw / 2 + u * (ph + k * 4));
+        G3_Begin(GX_BEGIN_QUADS);
+        G3_Vtx(x0, y0 + s * 2, z); // top bar
+        G3_Vtx(x0, y0 + s * 2 - u / 2, z);
+        G3_Vtx(x0 + s * 2, y0 + s * 2 - u / 2, z);
+        G3_Vtx(x0 + s * 2, y0 + s * 2, z);
+        G3_Vtx(x0 + s * 2 - u / 2, y0 + s * 2, z); // diagonal
+        G3_Vtx(x0, y0 + u / 2, z);
+        G3_Vtx(x0 + u / 2, y0 + u / 2, z);
+        G3_Vtx(x0 + s * 2, y0 + s * 2, z);
+        G3_Vtx(x0, y0 + u / 2, z); // bottom bar
+        G3_Vtx(x0, y0, z);
+        G3_Vtx(x0 + s * 2, y0, z);
+        G3_Vtx(x0 + s * 2, y0 + u / 2, z);
+        G3_End();
+    }
+}
+
+// 0218: water drops thrown out sideways and up when a water one jumps
+static void SS3DS_WildSplash(fx16 hw, int left) {
+    const fx16 u = FX16_ONE / 16, z = FX16_ONE / 8;
+    int age = 16 - left;
+    G3_TexImageParam(GX_TEXFMT_NONE, GX_TEXGEN_NONE, GX_TEXSIZE_S8, GX_TEXSIZE_T8, GX_TEXREPEAT_NONE, GX_TEXFLIP_NONE, GX_TEXPLTTCOLOR0_USE, 0);
+    G3_Color(GX_RGB(26, 30, 31));
+    G3_Begin(GX_BEGIN_QUADS);
+    for (int k = 0; k < 4; k++) {
+        int side = k < 2 ? -1 : 1, far = (k & 1) ? 2 : 1;
+        fx16 x = (fx16)(side * (hw / 3 + u * age * far / 3)), y = (fx16)(-hw + u * (age * (10 - age) * far / 8));
+        G3_Vtx(x - u, y + u, z);
+        G3_Vtx(x - u, y - u, z);
+        G3_Vtx(x + u, y - u, z);
+        G3_Vtx(x + u, y + u, z);
+    }
+    G3_End();
+    G3_Color(GX_RGB(31, 31, 31));
+}
