+// 0283: console clock mixed into the wild random numbers (spots, behaviours), so no two visits play out the same
+static u32 SS3DS_WildClockSeed(void) {
+    RTCDate date;
+    RTCTime time;
+    GF_RTC_CopyDateTime(&date, &time);
+    return ((u32)(time.hour * 3600 + time.minute * 60 + time.second) * 2654435761u) ^ ((u32)date.day * 40503u) ^ ((u32)date.month << 24);
+}
