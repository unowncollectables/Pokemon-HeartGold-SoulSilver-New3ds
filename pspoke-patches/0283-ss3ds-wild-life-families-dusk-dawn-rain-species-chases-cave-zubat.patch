+// 0283: each one's own quirk, from where and what it spawned as: 0 lazy (slow steps), 1 energetic (quick steps),
+// 2 watchful (looks around a lot), 3+ ordinary
+static int SS3DS_WildQuirk(const SS3DSWildMon *m) {
+    return (int)(((u32)m->sp * 31u + (u32)m->lv * 17u + (u32)(m->homeX & 0xFF) * 7u + (u32)(m->homeZ & 0xFF) * 13u) % 7u);
