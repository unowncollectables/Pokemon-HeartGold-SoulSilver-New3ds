+// 0283: is this species in the map's land table right now (time of day, swarm, radio)? 1 when there is no land table.
+int SS3DS_WildInTable(FieldSystem *fieldSystem, int species) {
+    EncounterData *encData = MapEvents_GetLoadedEncTable(fieldSystem);
