From a8b207526b73ac2632d784e35ecab633e88402ed Mon Sep 17 00:00:00 2001
From: ss3ds <ss3ds@localhost>
Date: Wed, 4 Nov 2026 19:04:25 -0500
Subject: [PATCH] ss3ds: hook 0215 no Start-menu cursor bar on the top screen
 while the Bottom menu tiles are up (start_menu.c)

---
 scripts/ss3ds_hooks.d/0215_startbar.py | 38 ++++++++++++++++++++++++++
 scripts/ss3ds_hooks.d/0215_startbar.sh |  5 ++++
 2 files changed, 43 insertions(+)
 create mode 100755 scripts/ss3ds_hooks.d/0215_startbar.py
 create mode 100755 scripts/ss3ds_hooks.d/0215_startbar.sh

diff --git a/scripts/ss3ds_hooks.d/0215_startbar.py b/scripts/ss3ds_hooks.d/0215_startbar.py
new file mode 100755
index 0000000..f339e05
--- /dev/null
+++ b/scripts/ss3ds_hooks.d/0215_startbar.py
@@ -0,0 +1,38 @@
+#!/usr/bin/env python3
+"""ss3ds 0215: no Start-menu cursor bar or arrow on the top screen while the port's Bottom menu tiles drive the Start menu. The
+game draws its menu frame (a grey bar with a down arrow) on main BG3 and a cursor arrow sprite when the Start menu opens; with the
+Bottom menu on, the Start menu is only ever opened behind the tiles (PARTY / BAG / POKEDEX ... taps), so they flashed on the top
+screen for a few frames on every tile flow and after the panel's party closed (Azahar, run 148). With P3DS_BmOn the BG3 screen is
+cleared instead of loaded and the cursor sprite is not drawn. Bottom menu off = the game's own code. Idempotent ('SS3DS 0215')."""
+import sys
+p = 'src/start_menu.c'
+s = open(p).read()
+if 'SS3DS 0215' in s:
+    sys.exit(0)
+old = '    GfGfxLoader_LoadScrnData(NARC_a_0_1_4, 13, fieldSystem->bgConfig, GF_BG_LYR_MAIN_3, 0, 0, TRUE, HEAP_ID_FIELD2);\n'
+if s.count(old) != 1:
+    sys.exit('0215_startbar: anchor not found exactly once in start_menu.c (skipped)')
+new = ('    { /* SS3DS 0215: the port\'s Bottom menu tiles cover the Start menu; its top-screen cursor bar stays hidden */\n'
+       '        extern volatile int P3DS_BmOn;\n'
+       '        if (P3DS_BmOn) {\n'
+       '            FillBgTilemapRect(fieldSystem->bgConfig, GF_BG_LYR_MAIN_3, 0, 0, 0, 0x20, 0x18, 0);\n'
+       '            ScheduleBgTilemapBufferTransfer(fieldSystem->bgConfig, GF_BG_LYR_MAIN_3);\n'
+       '        } else {\n'
+       '            GfGfxLoader_LoadScrnData(NARC_a_0_1_4, 13, fieldSystem->bgConfig, GF_BG_LYR_MAIN_3, 0, 0, TRUE, HEAP_ID_FIELD2);\n'
+       '        }\n'
+       '    }\n')
+s = s.replace(old, new)
+old2 = ('    if (startMenu->cursorActive) {\n'
+        '        SpriteList_RenderAndAnimateSprites(startMenu->spriteList);\n'
+        '    }\n')
+if s.count(old2) == 1:
+    s = s.replace(old2, ('    { /* SS3DS 0215: nor its cursor arrow sprite */\n'
+                         '        extern volatile int P3DS_BmOn;\n'
+                         '        if (startMenu->cursorActive && !P3DS_BmOn) {\n'
+                         '            SpriteList_RenderAndAnimateSprites(startMenu->spriteList);\n'
+                         '        }\n'
+                         '    }\n'))
+else:
+    print('0215_startbar: cursor sprite anchor not found, bar only')
+open(p, 'w').write(s)
+print('0215_startbar: start_menu.c hooked')
diff --git a/scripts/ss3ds_hooks.d/0215_startbar.sh b/scripts/ss3ds_hooks.d/0215_startbar.sh
new file mode 100755
index 0000000..943301c
--- /dev/null
+++ b/scripts/ss3ds_hooks.d/0215_startbar.sh
@@ -0,0 +1,5 @@
+# ss3ds 0215: Start-menu cursor bar not drawn on the top screen while the Bottom menu tiles are up (start_menu.c, main binary).
+# Optional: without it the bar flashes on the top screen during tile flows as before.
+if ! (cd "$C" && python3 "$ROOT/scripts/ss3ds_hooks.d/0215_startbar.py" && bash rebuild_game_object.sh src/start_menu.c start_menu.o none); then
+  log "ss3ds 0215 startbar hook skipped (see message above); the Start menu bar shows on the top screen as before"
+fi
