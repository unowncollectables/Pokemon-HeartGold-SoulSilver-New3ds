+// Search a small grid around the resident. If the destination is outside the
+// grid or occupied, take the first step toward the closest reachable tile.
+static int SS3DS_TownRouteStep(FieldSystem *fieldSystem, SS3DSWildState *S, int slot, int goalX, int goalZ) {
+    enum { RADIUS = 5, SIDE = RADIUS * 2 + 1, CELLS = SIDE * SIDE };
+    static const int kDx[4] = {0, 0, -1, 1}, kDz[4] = {-1, 1, 0, 0};
+    SS3DSWildMon *m = &S->m[slot];
+    u8 visited[CELLS] = {0}, queue[CELLS];
+    int start = RADIUS * SIDE + RADIUS;
+    int baseX = m->x - RADIUS, baseZ = m->z - RADIUS;
+    int dx = goalX - m->x, dz = goalZ - m->z;
+    int best = (dx < 0 ? -dx : dx) + (dz < 0 ? -dz : dz), step = -1;
+    int head = 0, tail = 0;
+    visited[start] = 6;
+    queue[tail++] = start;
+    while (head < tail) {
+        int at = queue[head++];
+        for (int dir = 0; dir < 4; dir++) {
+            int x = at % SIDE + kDx[dir], z = at / SIDE + kDz[dir];
+            if (x < 0 || x >= SIDE || z < 0 || z >= SIDE) {
+                continue;
+            }
+            int index = z * SIDE + x;
+            if (visited[index]) {
+                continue;
+            }
+            int tx = baseX + x, tz = baseZ + z;
+            if ((SS3DS_TownTile(fieldSystem, tx, tz) & 3) != 1 || SS3DS_WildCrowded(S, slot, tx, tz)) {
+                visited[index] = 5;
+                continue;
+            }
+            int first = at == start ? dir : visited[at] - 1;
+            visited[index] = first + 1;
+            queue[tail++] = index;
+            dx = goalX - tx;
+            dz = goalZ - tz;
+            int dist = (dx < 0 ? -dx : dx) + (dz < 0 ? -dz : dz);
+            if (dist == 0) {
+                return first;
+            }
+            if (dist < best) {
+                best = dist;
+                step = first;
+            }
+        }
+    }
+    return step;
+}
