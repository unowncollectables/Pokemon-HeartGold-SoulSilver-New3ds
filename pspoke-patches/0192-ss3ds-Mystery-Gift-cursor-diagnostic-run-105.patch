From ccb09954adaa7451e99c664814f3e07235feed10 Mon Sep 17 00:00:00 2001
From: Grok <grok@localhost>
Date: Mon, 2 Nov 2026 03:08:14 -0500
Subject: [PATCH] ss3ds: Mystery Gift moveCursorFunc PlaySE (run 105/116)

Native ov74_02235FF8 so MG ListMenu move still plays SEQ_SE_DP_SELECT.
Run 116 strips the temporary [SS-MG-CURSOR] dumps; gSS_MG_CursorDiag is
kept so later patches that context-match this symbol still apply.
---
 .../nitromain-perf/missing.c                  | 9 +++++++++
 .../maploader/native-provided.json            | 1 +
 2 files changed, 10 insertions(+)

diff --git a/port/soulsilver-native-core/nitromain-perf/missing.c b/port/soulsilver-native-core/nitromain-perf/missing.c
index 2738aa7..b0c1166 100644
--- a/port/soulsilver-native-core/nitromain-perf/missing.c
+++ b/port/soulsilver-native-core/nitromain-perf/missing.c
@@ -726,3 +726,12 @@ __attribute__((noreturn)) void ov00_021ED444(void){Missing("ov00_021ED444");}
 __attribute__((noreturn)) void ov00_021ED1F0(void){Missing("ov00_021ED1F0");}
 __attribute__((noreturn)) void ov00_021ED354(void){Missing("ov00_021ED354");}
 __attribute__((noreturn)) void ov00_021ECEC0(void){Missing("ov00_021ECEC0");}
+/* SS3DS run 105/116: Mystery Gift moveCursorFunc. PlaySE on move; gSS_MG_CursorDiag kept for patch compatibility. */
+int gSS_MG_CursorDiag;
+extern void PlaySE(unsigned short);
+void ov74_02235FF8(void *list, int index, unsigned onInit) {
+  (void)list;
+  (void)index;
+  gSS_MG_CursorDiag = 1;
+  if (!onInit) PlaySE(1500); /* SEQ_SE_DP_SELECT */
+}
diff --git a/port/soulsilver-native-play/maploader/native-provided.json b/port/soulsilver-native-play/maploader/native-provided.json
index 03e7209..2eec34e 100644
--- a/port/soulsilver-native-play/maploader/native-provided.json
+++ b/port/soulsilver-native-play/maploader/native-provided.json
@@ -552,6 +552,7 @@
 "ov18_021F9688",
 "ov18_021F9694",
 "ov58_022379C0",
+"ov74_02235FF8",
 "sub_02004A60",
 "sub_02004AB8",
 "sub_02005464",
