     return (day / 7) % 4;
 }
 
+// Called once per outdoor area load before the map texture palette is uploaded.
+void SS3DS_SeasonTreePalette(NNSG3dResTex *tex) {
+    extern int P3DS_CfgInt(const char *, int);
+    if (tex == NULL || tex->plttInfo.ofsDict == 0 || !P3DS_CfgInt("seasonal_trees", 0)) {
+        return;
+    }
+    RTCDate date;
+    GF_RTC_CopyDate(&date);
+    const s32 day = RTC_ConvertDateToDay(&date);
+    if (day < 0) {
+        return;
+    }
+    const int season = SS3DS_SeasonForDay((u32)day);
+    if (season == SEASON_SUMMER) {
+        return;
+    }
+    static const NNSG3dResName tree = { .name = "tree01_un" };
+    const NNSG3dResDictPlttData *entry = NNS_G3dGetPlttDataByName(tex, &tree);
+    if (entry == NULL) {
+        return;
+    }
+    const NNSG3dResDict *dict = (const NNSG3dResDict *)((const u8 *)tex + tex->plttInfo.ofsDict);
+    const u32 start = (u32)entry->offset << 3;
+    u32 end = (u32)tex->plttInfo.sizePltt << 3;
+    for (u32 i = 0; i < dict->numEntry; i++) {
+        const NNSG3dResDictPlttData *other = NNS_G3dGetPlttDataByIdx(tex, i);
+        const u32 offset = (u32)other->offset << 3;
+        if (offset > start && offset < end) {
+            end = offset;
+        }
+        if (offset == start) {
+            const NNSG3dResName *name = NNS_G3dGetPlttNameByIdx(tex, i);
+            if (strcmp(name->name, "tree01_un") && strcmp(name->name, "tree01_re")
+                && strcmp(name->name, "tree01")) {
+                return;
+            }
+        }
+    }
+    if (end < start || end - start != 16 * sizeof(GXRgb)) {
+        return;
+    }
+    GXRgb *colors = (GXRgb *)((u8 *)tex + tex->plttInfo.ofsPlttData + start);
+    // The common 16-color tree uses entries 1 to 5 for the canopy.
+    // Require the expected green ramp before touching the loaded palette.
+    for (int i = 1; i <= 5; i++) {
+        const int r = colors[i] & 31, g = (colors[i] >> 5) & 31, b = (colors[i] >> 10) & 31;
+        if (g <= r + 5 || g <= b + 2) {
+            return;
+        }
+    }
+    for (int i = 1; i <= 5; i++) {
+        const int r = colors[i] & 31, g = (colors[i] >> 5) & 31, b = (colors[i] >> 10) & 31;
+        if (season == SEASON_SPRING) {
+            colors[i] = GX_RGB((3 * r + 31) / 4, (4 * g + 31) / 5, 3 * b / 4);
+        } else if (season == SEASON_AUTUMN) {
+            colors[i] = GX_RGB((4 * g + 31) / 5, 2 * g / 3, b / 3);
+        } else {
+            colors[i] = GX_RGB((r + 31) / 2, (g + 31) / 2, (b + 31) / 2);
+        }
+    }
+    PSPNativeMemLog("[WEATHER] tree canopy season %d", season);
+}
