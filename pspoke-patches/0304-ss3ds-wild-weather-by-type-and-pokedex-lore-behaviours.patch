+// 0304: weather by type and Pokedex lore. Per-slot statics, cleared whenever a slot is empty and on every map change.
+#define SS3DS_VANISH 48
+static int sSS3DS_Vanish[SS3DS_WILD_MAX], sSS3DS_VanishKind[SS3DS_WILD_MAX], sSS3DS_Ports[SS3DS_WILD_MAX]; // 1 dig (Diglett), 2 teleport (Abra)
+static int sSS3DS_DittoMask, sSS3DS_FreezeMask, sSS3DS_Sing, sSS3DS_SingT, sSS3DS_Storm, sSS3DS_Hour = -1, sSS3DS_HourT;
+
+static void SS3DS_LoreReset(void) {
+    for (int k = 0; k < SS3DS_WILD_MAX; k++) {
+        sSS3DS_Vanish[k] = sSS3DS_VanishKind[k] = sSS3DS_Ports[k] = 0;
+    }
+    sSS3DS_DittoMask = sSS3DS_FreezeMask = sSS3DS_Sing = sSS3DS_SingT = 0;
+    sSS3DS_Hour = -1;
+}
+
+static int SS3DS_TypeFire(int sp) {
+    switch (sp) {
+    case 4: case 5: case 6: case 37: case 38: case 58: case 59: case 77: case 78: case 126: case 136: case 146: case 155: case 156:
+    case 157: case 218: case 219: case 228: case 229: case 240: case 244: case 250:
+        return 1;
+    default:
+        return 0;
+    }
+}
+
+static int SS3DS_TypeIce(int sp) {
+    switch (sp) {
+    case 87: case 91: case 124: case 131: case 144: case 215: case 220: case 221: case 225: case 238: case 361: case 362: case 459:
+    case 460: case 461: case 473:
+        return 1;
+    default:
+        return 0;
+    }
+}
+
+static int SS3DS_TypeElectric(int sp) {
+    switch (sp) {
+    case 25: case 26: case 81: case 82: case 100: case 101: case 125: case 135: case 145: case 170: case 171: case 172: case 179:
+    case 180: case 181: case 239: case 243: case 309: case 310: case 403: case 404: case 405: case 417: case 462: case 466:
+        return 1;
+    default:
+        return 0;
+    }
+}
+
+// weather picks the species: no fire types out in the rain, ice types come out in the snow, electric types in a
+// thunderstorm, fire types a little more on clear days. Only from this map's own table. 0 = skip this spawn try.
+static int SS3DS_WeatherPick(FieldSystem *fieldSystem, SS3DSWildState *S, int env, int *sp, int *lv) {
+    int want = (env & 4) ? 1 : sSS3DS_Storm ? 2 : (!(env & 3) && (env & WILD_DAY)) ? 3 : 0;
+    if ((env & 2) && SS3DS_TypeFire(*sp)) {
+        for (int t = 0; t < 3; t++) {
+            int s2, l2;
+            if (SS3DS_WildPick(fieldSystem, 0, &s2, &l2) && !SS3DS_TypeFire(s2)) {
+                *sp = s2;
+                *lv = l2;
+                return 1;
+            }
+        }
+        return 0; // only fire types here and it is raining: they stay in their dens
+    }
+    if (!want || SS3DS_WildRand(S, want == 3 ? 3 : 2) != 0) {
+        return 1;
+    }
+    for (int t = 0; t < 4; t++) {
+        int s2, l2;
+        if (!SS3DS_WildPick(fieldSystem, 0, &s2, &l2)) {
+            break;
+        }
+        if ((want == 1 && SS3DS_TypeIce(s2)) || (want == 2 && SS3DS_TypeElectric(s2)) || (want == 3 && SS3DS_TypeFire(s2))) {
+            *sp = s2;
+            *lv = l2;
+            PSPNativeMemLog("[WILD] the weather brings out species %d", s2);
+            return 1;
+        }
+    }
+    return 1;
+}
+
+static int SS3DS_WeatherLively(int sp, int env) {
+    return (sSS3DS_Storm && SS3DS_TypeElectric(sp)) || ((env & 4) && SS3DS_TypeIce(sp));
+}
+
+// Abra teleports / Diglett digs: halfway through it moves to a free spot a few tiles off, out of the player's sight
+static void SS3DS_VanishMove(FieldSystem *fieldSystem, SS3DSWildState *S, SS3DSWildMon *m, int i, int px, int pz) {
+    for (int t = 0; t < 10; t++) {
+        int x = m->x + (int)SS3DS_WildRand(S, 11) - 5, z = m->z + (int)SS3DS_WildRand(S, 9) - 4;
+        int dx = x - px, dz = z - pz, d = (dx < 0 ? -dx : dx) + (dz < 0 ? -dz : dz);
+        int tile = SS3DS_WildTileKind(fieldSystem, x, z);
+        if (d < 5 || d > 8 || (tile & 3) != m->kind || SS3DS_WildCrowded(S, i, x, z)) {
+            continue;
+        }
+        m->x = m->fx = m->homeX = x;
+        m->z = m->fz = m->homeZ = z;
+        m->grass = (tile & 4) != 0;
+        m->noticed = WILD_UNAWARE;
+        m->hop = m->bang = 0;
+        m->rustle = m->grass ? 12 : 0;
+        PSPNativeMemLog("[WILD] slot %d species %d %s to %d,%d", i + 1, m->sp, sSS3DS_VanishKind[i] == 2 ? "teleported" : "popped up", x, z);
+        return;
+    }
+}
+
+// lore when one notices the player. 1 = handled (no lead check)
+static int SS3DS_LoreNotice(SS3DSWildState *S, SS3DSWildMon *m, int i) {
+    if ((m->sp == 63 || m->sp == 50 || m->sp == 51) && sSS3DS_Ports[i] < (m->sp == 63 ? 2 : 3) && !m->big && m->roamer < 0) {
+        sSS3DS_Vanish[i] = SS3DS_VANISH;
+        sSS3DS_VanishKind[i] = m->sp == 63 ? 2 : 1;
+        sSS3DS_Ports[i]++;
+        m->hop = 0;
+        PSPNativeMemLog("[WILD] slot %d species %d %s", i + 1, m->sp, m->sp == 63 ? "teleports away" : "digs underground");
+        return 1;
+    }
+    if (m->sp == 185 || (sSS3DS_DittoMask & (1 << i))) {
+        m->hop = m->bang = 0; // a "tree" and a disguise do not give themselves away
+        return 1;
+    }
+    return 0;
+}
+
+// per frame, before the wilds move: Hoothoot on the hour, Jigglypuff's song, slots that emptied
+static void SS3DS_LoreTick(FieldSystem *fieldSystem, SS3DSWildState *S, int px, int pz, int env) {
+    for (int k = 0; k < SS3DS_WILD_MAX; k++) {
+        if (!S->m[k].on) {
+            sSS3DS_Vanish[k] = sSS3DS_VanishKind[k] = sSS3DS_Ports[k] = 0;
+            sSS3DS_DittoMask &= ~(1 << k);
+            sSS3DS_FreezeMask &= ~(1 << k);
+        }
+    }
+    if (sSS3DS_Sing && (!S->m[sSS3DS_Sing - 1].on || S->m[sSS3DS_Sing - 1].battle)) {
+        sSS3DS_Sing = 0;
+    }
+    if (sSS3DS_Sing && --sSS3DS_SingT == 60) {
+        SS3DSWildMon *j = &S->m[sSS3DS_Sing - 1];
+        int n = 0;
+        for (int k = 0; k < SS3DS_WILD_MAX; k++) {
+            SS3DSWildMon *o = &S->m[k];
+            int ox = o->x - j->x, oz = o->z - j->z;
+            if (k == sSS3DS_Sing - 1 || !o->on || o->spare || o->battle || o->big || o->roamer >= 0 || o->kind != 1 || o->sleep
+                || o->noticed == WILD_STARTLED || (ox < 0 ? -ox : ox) + (oz < 0 ? -oz : oz) > 4) {
+                continue;
+            }
+            o->sleep = 360 + (int)SS3DS_WildRand(S, 240);
+            o->noticed = WILD_UNAWARE;
+            o->hop = 0;
+            n++;
+        }
+        PSPNativeMemLog("[WILD] Jigglypuff's song put %d to sleep", n);
+    }
+    if (sSS3DS_Sing && sSS3DS_SingT <= 0) {
+        sSS3DS_Sing = 0;
+    }
+    if (++sSS3DS_HourT >= 120) { // Hoothoot keeps time: it hoots on the hour at night
+        sSS3DS_HourT = 0;
+        RTCDate date;
+        RTCTime time;
+        GF_RTC_CopyDateTime(&date, &time);
+        int hour = time.hour;
+        if (sSS3DS_Hour >= 0 && hour != sSS3DS_Hour && (env & 1) && MapHeader_IsOutdoors(fieldSystem->location->mapId)) {
+            int heard = 0;
+            for (int k = 0; k < SS3DS_WILD_MAX; k++) {
+                SS3DSWildMon *o = &S->m[k];
+                int ox = o->x - px, oz = o->z - pz;
+                if (o->on && !o->battle && (o->sp == 163 || o->sp == 164) && (ox < 0 ? -ox : ox) + (oz < 0 ? -oz : oz) <= 10) {
+                    o->sleep = 0;
+                    o->hop = 10;
+                    if (!heard) {
+                        heard = SS3DS_WildCue(S, o->sp, 0);
+                    }
+                }
+            }
+            if (!heard && MapHeader_HasWildEncounters(fieldSystem->location->mapId) && SS3DS_WildInTable(fieldSystem, 163)) {
+                heard = SS3DS_WildCue(S, 163, 0); // one out of sight in the trees
+            }
+            if (heard) {
+                PSPNativeMemLog("[WILD] a Hoothoot hoots: %d o'clock", hour);
+            }
+        }
+        sSS3DS_Hour = hour;
+    }
+}
+
+// a little yellow spark beside an electric type in a thunderstorm
+static void SS3DS_WildSpark(fx16 hw, u32 anim) {
+    const fx16 u = FX16_ONE / 16, z = FX16_ONE / 8;
+    fx16 x0 = (anim & 32) ? (fx16)(hw * 3 / 4) : (fx16)(-hw * 3 / 4 - u * 3), y0 = (fx16)(hw / 3);
+    G3_TexImageParam(GX_TEXFMT_NONE, GX_TEXGEN_NONE, GX_TEXSIZE_S8, GX_TEXSIZE_T8, GX_TEXREPEAT_NONE, GX_TEXFLIP_NONE, GX_TEXPLTTCOLOR0_USE, 0);
+    G3_Color(GX_RGB(31, 30, 4));
+    G3_Begin(GX_BEGIN_QUADS);
+    G3_Vtx(x0, y0 + u * 4, z); // a small zigzag: two slanted bars
+    G3_Vtx(x0 + u, y0 + u * 4, z);
+    G3_Vtx(x0 + u * 3, y0 + u * 2, z);
+    G3_Vtx(x0 + u * 2, y0 + u * 2, z);
+    G3_Vtx(x0 + u * 1, y0 + u * 2, z);
+    G3_Vtx(x0 + u * 2, y0 + u * 2, z);
+    G3_Vtx(x0 + u, y0, z);
+    G3_Vtx(x0, y0, z);
+    G3_End();
+    G3_Color(GX_RGB(31, 31, 31));
+}
+
+// two music notes drifting up beside Jigglypuff while it sings
+static void SS3DS_WildNotes(fx16 hw, u32 anim) {
+    const fx16 u = FX16_ONE / 16, z = FX16_ONE / 8;
+    G3_TexImageParam(GX_TEXFMT_NONE, GX_TEXGEN_NONE, GX_TEXSIZE_S8, GX_TEXSIZE_T8, GX_TEXREPEAT_NONE, GX_TEXFLIP_NONE, GX_TEXPLTTCOLOR0_USE, 0);
+    G3_Color(GX_RGB(31, 20, 26));
+    for (int k = 0; k < 2; k++) {
+        int ph = (int)((anim >> 2) + k * 8) % 16;
+        fx16 x0 = (fx16)((k ? -hw : hw / 2) + u * (ph & 4 ? 1 : 0)), y0 = (fx16)(hw / 2 + u * ph);
+        G3_Begin(GX_BEGIN_QUADS);
+        G3_Vtx(x0, y0 + u * 2, z); // head
+        G3_Vtx(x0, y0, z);
+        G3_Vtx(x0 + u * 2, y0, z);
+        G3_Vtx(x0 + u * 2, y0 + u * 2, z);
+        G3_Vtx(x0 + u * 3 / 2, y0 + u * 6, z); // stem
+        G3_Vtx(x0 + u * 3 / 2, y0 + u, z);
+        G3_Vtx(x0 + u * 2, y0 + u, z);
+        G3_Vtx(x0 + u * 2, y0 + u * 6, z);
+        G3_End();
+    }
+    G3_Color(GX_RGB(31, 31, 31));
+}
+
