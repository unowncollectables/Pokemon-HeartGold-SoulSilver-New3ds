+// The outdoor clerk is a temporary native sprite. The original indoor
+// shopkeeper remains in the shop with her story and dialogue.
+static LocalMapObject *SS3DS_TownClerk(FieldSystem *fieldSystem) {
+    if (!fieldSystem->mapObjectManager) {
+        return NULL;
+    }
+    LocalMapObject *clerk = MapObjectManager_GetFirstActiveObjectByID(fieldSystem->mapObjectManager, SS3DS_CLERK_ID);
+    return clerk && MapObject_GetMapID(clerk) == MAP_GOLDENROD && MapObject_GetSpriteID(clerk) == SPRITE_GSWOMAN1
+        ? clerk : NULL;
+}
+
+static void SS3DS_TownClerkRemove(FieldSystem *fieldSystem, SS3DSWildState *S) {
+    if (S->clerkT > 0) {
+        LocalMapObject *clerk = SS3DS_TownClerk(fieldSystem);
+        if (clerk) {
+            MapObject_Remove(clerk);
+        }
+    }
+    S->clerkT = -1;
+}
+
+static int SS3DS_TownClerkFollow(FieldSystem *fieldSystem, SS3DSWildState *S, int i, int doorX, int doorZ) {
+    SS3DSWildMon *m = &S->m[i];
+    if (S->clerkT < 0 || !fieldSystem->mapObjectManager) {
+        return 0;
+    }
+    int px = PlayerAvatar_GetXCoord(fieldSystem->playerAvatar);
+    int pz = PlayerAvatar_GetZCoord(fieldSystem->playerAvatar);
+    int stageZ = doorZ + 2;
+    LocalMapObject *clerk = SS3DS_TownClerk(fieldSystem);
+    if (!clerk && S->clerkT == 0) {
+        // Start at the same door approach as the resident, but two tiles ahead.
+        int x = m->x, z = m->z - (m->z > stageZ + 2 ? 2 : 1);
+        if (z < stageZ || z - stageZ > 5 || x < doorX - 3 || x > doorX + 3
+            || (SS3DS_TownTile(fieldSystem, x, z) & 3) != 1 || SS3DS_WildCrowded(S, i, x, z)) {
+            return 0;
+        }
+        ObjectEvent event = {0};
+        event.id = SS3DS_CLERK_ID;
+        event.spriteId = SPRITE_GSWOMAN1;
+        event.movement = MOVEMENT_FACE_UP;
+        event.x = x;
+        event.z = z;
+        clerk = MapObject_CreateFromObjectEventWithId(fieldSystem->mapObjectManager, SS3DS_CLERK_ID, 1, MAP_GOLDENROD, &event);
+        if (!clerk) {
+            return 0;
+        }
+        S->clerkT = 1;
+        PSPNativeMemLog("[WILD] Bellossom follows the Flower Shop clerk");
+    }
+    if (!clerk || ++S->clerkT > 220) {
+        SS3DS_TownClerkRemove(fieldSystem, S);
+        return 0;
+    }
+    if (!MapObject_ClearHeldMovementIfActive(clerk)) {
+        return 1;
+    }
+    int x = MapObject_GetXCoord(clerk), z = MapObject_GetZCoord(clerk);
+    if (x == doorX && z <= stageZ) {
+        if (z <= doorZ) {
+            SS3DS_TownClerkRemove(fieldSystem, S);
+            return 0;
+        }
+        int front = z - 1;
+        u8 behavior = GetMetatileBehavior(fieldSystem, x, front);
+        int doorway = front == doorZ && Field_GetWarpEventAtXYPos(fieldSystem, x, front) >= 0;
+        if ((doorway || (behavior == 0 && !sub_020548C0(fieldSystem, x, front)))
+            && !MapObjectManager_GetFirstObjectWithXAndZ(fieldSystem->mapObjectManager, x, front, TRUE)) {
+            MapObject_SetHeldMovement(clerk, MOVEMENT_STEP_UP);
+        } else {
+            SS3DS_TownClerkRemove(fieldSystem, S);
+            return 0;
+        }
+    } else {
+        int d = x == doorX ? 0 : x < doorX ? 3 : 2;
+        int nx = x + (d == 2 ? -1 : d == 3 ? 1 : 0), nz = z - (d == 0);
+        if ((SS3DS_TownTile(fieldSystem, nx, nz) & 3) == 1 && !SS3DS_WildCrowded(S, -1, nx, nz)) {
+            MapObject_SetHeldMovement(clerk, MOVEMENT_STEP_UP + d);
+        }
+    }
+    int dx = m->x - x, dz = m->z - z;
+    if ((dx < 0 ? -dx : dx) + (dz < 0 ? -dz : dz) > 1 && m->t >= 16 && --m->timer <= 0) {
+        int d = SS3DS_TownRouteStep(fieldSystem, S, i, x, z);
+        m->timer = 6;
+        if (d >= 0) {
+            int nx = m->x + (d == 2 ? -1 : d == 3 ? 1 : 0), nz = m->z + (d == 0 ? -1 : d == 1 ? 1 : 0);
+            if (nx != px || nz != pz) {
+                m->dir = d;
+                m->fx = m->x;
+                m->fz = m->z;
+                m->x = nx;
+                m->z = nz;
+                m->t = 0;
+                m->grass = 0;
+            }
+        }
+    }
+    return 1;
+}
