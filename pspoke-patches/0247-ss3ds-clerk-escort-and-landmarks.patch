+    }
     if (S->spawnT > 0) {
         S->spawnT--;
     }
@@ -1646,6 +1777,9 @@ static void SS3DS_WildTick(FieldSystem *fieldSystem) {
         if (leaving && m->spare == 2 && dist > 1) {
             SS3DS_WildEndPlay(S, i);
             m->sleep = 0;
+            if (clerkScene && SS3DS_TownClerkFollow(fieldSystem, S, i, doorX, doorZ)) {
+                continue;
+            }
             if (--m->timer <= 0) {
                 m->timer = 8;
                 SS3DS_TownDepart(fieldSystem, S, i, doorX, doorZ, doorSide);
@@ -2124,7 +2258,7 @@ static void SS3DS_WildDrawOne(FieldSystem *fieldSystem, SS3DSWildMon *m, int slo
     c.x = ((m->fx * 16 + 8) * FX32_ONE) + FX_Mul((m->x - m->fx) * 16 * FX32_ONE, tt);
     c.z = ((m->fz * 16 + 8) * FX32_ONE) + FX_Mul((m->z - m->fz) * 16 * FX32_ONE, tt);
     if (m->pad < 0) {
-        c.z += (m->dir == 0 ? -1 : 1) * (16 + m->pad) * FX32_ONE / 2;
+        c.z += (m->dir == 0 ? -1 : 1) * (16 + m->pad) * (3 * FX32_ONE / 2);
     }
     py = SS3DS_WildGroundY(fieldSystem, c.x, c.z, py);
     G3_MtxMode(GX_MTXMODE_POSITION_VECTOR);
@@ -2448,6 +2582,35 @@ if which in ('all', 'field'):
             sys.exit('0110_wildvis: FieldMap_Main not found exactly once in fieldmap.c')
         open(p, 'w').write(s.replace(main, proto + '\n' + main))
         print('0110_wildvis: fieldmap.c prototypes added (0112)')
+if which in ('all', 'clerk'):
+    p = 'src/map_object.c'
+    s = open(p).read()
+    tag = 'SS3DS 0247 temporary clerk'
+    if tag not in s:
+        anchor = '        SavedMapObject_InitFromLocalMapObject(fieldSystem, object, savedObjects);'
+        if s.count(anchor) != 1:
+            sys.exit('0110_wildvis: clerk save anchor not found exactly once')
+        s = '#include "constants/maps.h"\n#include "constants/sprites.h"\n' + s.replace(anchor,
+            '        // ' + tag + ' is never serialized.\n'
+            '        if (MapObject_GetID(object) == 0xF0 && MapObject_GetMapID(object) == MAP_GOLDENROD\n'
+            '            && MapObject_GetSpriteID(object) == SPRITE_GSWOMAN1) {\n'
+            '            continue;\n'
+            '        }\n' + anchor)
+        open(p, 'w').write(s)
+        print('0110_wildvis: clerk save exclusion applied')
+    p = 'src/field/field_control.c'
+    s = open(p).read()
+    if tag not in s:
+        start = s.index('int FieldInput_Process(')
+        anchor = '        if (sub_0203DC64(fieldSystem, &mapObject) == TRUE) {'
+        a = s.index(anchor, start)
+        s = s[:a] + s[a:].replace(anchor,
+            '        if (sub_0203DC64(fieldSystem, &mapObject) == TRUE\n'
+            '            && !(MapObject_GetID(mapObject) == 0xF0 && MapObject_GetMapID(mapObject) == MAP_GOLDENROD\n'
+            '                && MapObject_GetSpriteID(mapObject) == SPRITE_GSWOMAN1)) { // ' + tag, 1)
+        s = '#include "constants/maps.h"\n#include "constants/sprites.h"\n' + s
+        open(p, 'w').write(s)
+        print('0110_wildvis: clerk interaction exclusion applied')
 if which in ('all', 'battle'):
     # the outcome of every battle, so a visible one the player ran from can stay (read by fieldmap.c)
