     }
@@ -1359,6 +1487,9 @@ static void SS3DS_WildTick(FieldSystem *fieldSystem) {
         n += S->m[i].on != 0;
         named |= S->m[i].on && S->m[i].spare == 2;
     }
+    if (S->clerkT > 0 && !named) {
