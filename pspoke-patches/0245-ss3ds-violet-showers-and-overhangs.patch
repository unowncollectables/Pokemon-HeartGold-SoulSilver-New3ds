+// The native manager owns the effect. Keep the shower timer in transient
+// field state and never update LocalFieldData, which is part of the save.
+extern int ov01_021EB31C(void *weatherManager);
+
+static int SS3DS_TownShower(FieldSystem *fieldSystem, SS3DSWildState *S, int enabled, int entered) {
+    if (fieldSystem->location == NULL || fieldSystem->location->mapId != MAP_VIOLET
+        || fieldSystem->unk4 == NULL || fieldSystem->unk4->weatherManager == NULL) {
+        return 0;
+    }
+    int weather = LocalFieldData_GetWeatherType(Save_LocalFieldData_Get(fieldSystem->saveData));
+    void *manager = fieldSystem->unk4->weatherManager;
+    if (FieldSystem_TaskIsRunning(fieldSystem)) {
+        return enabled && weather == WEATHER_SUNNY && S->townShowerT < 0;
+    }
+    if (!enabled || weather != WEATHER_SUNNY) {
+        if (S->townShowerT < 0) {
+            WeatherManager_ChangeWeather(manager, weather);
+        }
+        S->townShowerT = 0;
+        return 0;
+    }
+    int before = S->townShowerT;
+    if (before > 1) {
+        S->townShowerT--;
+    } else if (before == 1) {
+        S->townShowerT = -540;
+        PSPNativeMemLog("[WILD] Violet shower starts");
+    } else if (before < -1) {
+        S->townShowerT++;
+    } else {
+        S->townShowerT = 900 + (int)SS3DS_WildRand(S, 600);
+        if (before == -1) {
+            PSPNativeMemLog("[WILD] Violet shower clears");
+        }
+    }
+    int rain = S->townShowerT < 0;
+    if (before == 1 || before == -1 || entered
+        || (S->anim % 60 == 0 && ov01_021EB31C(manager) != (rain ? WEATHER_RAIN : WEATHER_SUNNY))) {
+        WeatherManager_ChangeWeather(manager, rain ? WEATHER_RAIN : WEATHER_SUNNY);
+    }
+    return rain;
+}
