+// Open tiles beneath the Violet School and Gym overhang meshes (props 58
+// and 44). The live tile checks still apply when residents use these spots.
+typedef struct {
+    u16 map, z, firstX, lastX;
+} SS3DSCoveredRow;
+
+static const SS3DSCoveredRow kSS3DSTownCover[] = {
+    {MAP_VIOLET, 254, 492, 495},
+    {MAP_VIOLET, 255, 492, 495},
+    {MAP_VIOLET, 254, 477, 477},
+    {MAP_VIOLET, 255, 476, 479},
+};
+
+static int SS3DS_TownCovered(int map, int x, int z) {
+    for (u32 i = 0; i < sizeof(kSS3DSTownCover) / sizeof(kSS3DSTownCover[0]); i++) {
+        const SS3DSCoveredRow *row = &kSS3DSTownCover[i];
+        if (map == row->map && z == row->z && x >= row->firstX && x <= row->lastX) {
+            return 1;
+        }
+    }
+    return 0;
+}
+
+static int SS3DS_TownCoverStep(FieldSystem *fieldSystem, SS3DSWildState *S, int slot, int map) {
+    SS3DSWildMon *m = &S->m[slot];
+    int best = 7, x = 0, z = 0;
+    for (u32 i = 0; i < sizeof(kSS3DSTownCover) / sizeof(kSS3DSTownCover[0]); i++) {
+        const SS3DSCoveredRow *row = &kSS3DSTownCover[i];
+        if (map != row->map) {
+            continue;
+        }
+        int dz = row->z - m->z;
+        for (int tx = row->firstX; tx <= row->lastX; tx++) {
+            int dx = tx - m->x;
+            int dist = (dx < 0 ? -dx : dx) + (dz < 0 ? -dz : dz);
+            if (dist < best && (SS3DS_TownTile(fieldSystem, tx, row->z) & 3) == 1
+                && !SS3DS_WildCrowded(S, slot, tx, row->z)) {
+                x = tx;
+                z = row->z;
+                best = dist;
+            }
+        }
+    }
+    return best < 7 ? SS3DS_TownRouteStep(fieldSystem, S, slot, x, z) : -1;
+}
+
