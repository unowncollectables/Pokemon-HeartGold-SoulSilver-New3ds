From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ss3ds <ss3ds@localhost>
Date: Wed, 18 Nov 2026 16:45:00 +0000
Subject: [PATCH] ss3ds: visible wilds: no battle across the shore line (run
 939 crash)

Run 939 crashed (memcpy to NULL right after the battle start) when a water Tentacool next to the shore was bumped into from land: the forced surf battle ran with the player standing on land. A water one now only battles while the player is surfing and a land one only while the player is on land; across the shore line it turns, hops (and splashes) and calls instead. Log: "is across the shore line (water|land), no battle".
---
 scripts/ss3ds_hooks.d/0110_wildvis.py | 21 ++++++++++++++++++++-
 1 file changed, 20 insertions(+), 1 deletion(-)

diff --git a/scripts/ss3ds_hooks.d/0110_wildvis.py b/scripts/ss3ds_hooks.d/0110_wildvis.py
index 7086983..daaf7a3 100644
--- a/scripts/ss3ds_hooks.d/0110_wildvis.py
+++ b/scripts/ss3ds_hooks.d/0110_wildvis.py
@@ -13,7 +13,7 @@ import os
 import sys
 
 COMMON = r'''
-/* SS3DS-WILD-BEGIN v24 (0110/0111/0217/0218/0223/0224/0281/0282/0283: everything between BEGIN and END is replaced by the hook on every build) */
+/* SS3DS-WILD-BEGIN v25 (0110/0111/0217/0218/0223/0224/0281/0282/0283/0284: everything between BEGIN and END is replaced by the hook on every build) */
 /* SS3DS 0110 visible wild Pokemon. The state lives in the port (P3DS_WildMemV2, platform g3soft.cpp) so it survives the
    field overlay being unloaded for menus, the bag and battles. Nothing here is saved. Same layout in fieldmap.c and
    encounter_check.c. */
@@ -405,6 +405,25 @@ int SS3DS_WildTalk(FieldSystem *fieldSystem, int interact) {
         }
         return 0;
     }
+    // 0284: a water one is only battled while surfing and a land one only from land. Run 939 crashed (memcpy to NULL in the
+    // battle start) on a forced surf battle with the player standing on the shore. Across the shore line it just reacts.
+    int playerWater = MetatileBehavior_IsSurfableWater(GetMetatileBehavior(fieldSystem,
+        PlayerAvatar_GetXCoord(fieldSystem->playerAvatar), PlayerAvatar_GetZCoord(fieldSystem->playerAvatar))) ? 1 : 0;
+    if ((m->kind == 2) != playerWater) {
+        sSS3DS_Bump = 0;
+        S->cool = 90;
+        if (m->t >= 16 && m->hop == 0) {
+            m->dir = PlayerAvatar_GetFacingDirection(fieldSystem->playerAvatar) ^ 1;
+            m->sleep = 0;
+            m->hop = 10;
+            if (m->kind == 2) {
+                m->splash = 16;
+            }
+            SS3DS_WildCue(S, m->sp, 0);
+        }
+        PSPNativeMemLog("[WILD] slot %d species %d is across the shore line (%s), no battle", i + 1, m->sp, m->kind == 2 ? "water" : "land");
+        return 0;
+    }
     PSPNativeMemLog("[WILD] talk/bump slot %d species %d lv %d%s -> battle", i + 1, m->sp, m->lv, m->shiny ? " SHINY" : "");
     P3DS_WildBattleResult = -1;
     BOOL ret = SS3DS_WildEncounter(fieldSystem, m->sp, m->lv, m->shiny, m->roamer, m->kind);
-- 
