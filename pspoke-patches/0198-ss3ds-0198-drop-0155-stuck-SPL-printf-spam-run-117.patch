From: ss3ds <ss3ds@localhost>
Date: Mon, 2 Nov 2026 11:37:45 -0500
Subject: [PATCH 1/2] ss3ds: 0198 drop 0155 stuck-SPL printf spam (run 117)

Supersonic hang was fixed by 0156. Remove the temporary wait/skip
printf diagnostics from glue.c. No behavior change.
---
 port/soulsilver-native-particles/glue.c | 8 --------
 1 file changed, 8 deletions(-)

diff --git a/port/soulsilver-native-particles/glue.c b/port/soulsilver-native-particles/glue.c
index bd90aac..eed9ed1 100644
--- a/port/soulsilver-native-particles/glue.c
+++ b/port/soulsilver-native-particles/glue.c
@@ -1,4 +1,3 @@
-#include <stdio.h>
 #include "unk_02014DA0.h"
 
 #include "global.h"
@@ -692,12 +691,6 @@ BOOL sub_020154B0(SPLEmitter *emitter) {
     for (SPLEmitter *e = sys->spl->act_emtr_list.p_begin; e != NULL && n < 256; e = e->p_next) {
         n++;
     }
-    /* SS3DS 0155: log what a battle animation is still waiting on (Supersonic hang hunt). */
-    static int s_calls;
-    if (n > 0 && (++s_calls % 120) == 0) {
-        SPLEmitter *e = sys->spl->act_emtr_list.p_begin;
-        printf("[SS-PARTICLES] 0155 wait sys=%p stored=%d real=%d first=%p\n", (void *)sys, (int)sys->spl->act_emtr_list.node_num, n, (void *)e);
-    }
     sys->spl->act_emtr_list.node_num = n;
     return n;
 }
@@ -719,7 +712,6 @@ void sub_020154C4(SPLEmitter *emitter, SPLEmitter *active) {
             return;
         }
     }
-    printf("[SS-PARTICLES] 0155 skip delete sys=%p emtr=%p (not in active list)\n", (void *)sys, (void *)active);
 }
 
 void *sub_020154D0(SPLEmitter *emitter) {
