Subject: [PATCH] native CRYPTO_RC4Encrypt (ARM routine the maploader can't
 translate)

---
 .../nitromain-perf/missing.c                  |  2 +
 .../maploader/native-provided.json            | 85 ++++++++++---------
 2 files changed, 45 insertions(+), 42 deletions(-)

diff --git a/port/soulsilver-native-core/nitromain-perf/missing.c b/port/soulsilver-native-core/nitromain-perf/missing.c
index 0a0ac92..3e7cb1f 100644
--- a/port/soulsilver-native-core/nitromain-perf/missing.c
+++ b/port/soulsilver-native-core/nitromain-perf/missing.c
@@ -707,3 +707,5 @@ __attribute__((noreturn)) void sub_02096AAC(void){Missing("sub_02096AAC");}
 __attribute__((noreturn)) void sub_02096AF4(void){Missing("sub_02096AF4");}
 __attribute__((noreturn)) void sub_02096BF8(void){Missing("sub_02096BF8");}
 __attribute__((noreturn)) void sub_02096C40(void){Missing("sub_02096C40");}
+/* NitroSDK CRYPTO_RC4Encrypt (ARM in the ROM, which the Thumb translator can't take). Context: i@0, j@1, S[256]@4. */
+void CRYPTO_RC4Encrypt(void *ctx,const void *in,unsigned len,void *out){unsigned char *c=ctx,*s=c+4;const unsigned char *p=in;unsigned char *o=out;unsigned i=c[0],j=c[1];while(len--){i=(i+1)&0xff;unsigned char a=s[i];j=(j+a)&0xff;unsigned char b=s[j];s[i]=b;s[j]=a;*o++=*p++^s[(a+b)&0xff];}c[0]=i;c[1]=j;}
