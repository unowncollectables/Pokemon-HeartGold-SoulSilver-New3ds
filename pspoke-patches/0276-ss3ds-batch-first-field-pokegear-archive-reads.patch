From 4dd7e9cd356b1402fbfcaa47454c1c6a3927992e Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Sun, 15 Nov 2026 17:30:39 -0500
Subject: [PATCH] ss3ds: batch first field Pokegear archive reads

---
 scripts/ss3ds_hooks.d/0276_pgear_load.py | 94 ++++++++++++++++++++++++
 scripts/ss3ds_hooks.d/0276_pgear_load.sh |  2 +
 2 files changed, 96 insertions(+)
 create mode 100644 scripts/ss3ds_hooks.d/0276_pgear_load.py
 create mode 100644 scripts/ss3ds_hooks.d/0276_pgear_load.sh

diff --git a/scripts/ss3ds_hooks.d/0276_pgear_load.py b/scripts/ss3ds_hooks.d/0276_pgear_load.py
new file mode 100644
index 0000000..bc20914
--- /dev/null
+++ b/scripts/ss3ds_hooks.d/0276_pgear_load.py
@@ -0,0 +1,94 @@
+from pathlib import Path
+
+path = Path("src/field/field_control.c")
+s = path.read_text()
+if "SS3DS 0276" in s:
+    raise SystemExit(0)
+
+
+def change(old, new):
+    global s
+    if s.count(old) != 1:
+        raise SystemExit(f"0276_pgear_load: expected one match for {old.splitlines()[0]}")
+    s = s.replace(old, new, 1)
+
+
+change('#include "field/field_control.h"', """#include "field/field_control.h"
+#include "encounter_tables_narc.h" /* SS3DS 0276 */
+extern unsigned int sceKernelGetSystemTimeLow(void);""")
+
+start = s.index("static void SS3DS_PgOnce(void)")
+end = s.index("    for (i = 0; i < 3; i++) {", start)
+s = s[:start] + """static BOOL SS3DS_PgReadStrings(int member, BOOL descriptions, String *str) {
+    int i;
+    MsgData *data = NewMsgDataFromNarc(MSGDATA_LOAD_DIRECT, NARC_msgdata_msg, member, HEAP_ID_FIELD1);
+    if (data == NULL) data = NewMsgDataFromNarc(MSGDATA_LOAD_LAZY, NARC_msgdata_msg, member, HEAP_ID_FIELD1);
+    if (data == NULL) return FALSE;
+    for (i = 0; i < 100; i++) {
+        if (descriptions) {
+            ReadMsgDataIntoString(data, sLocationSpecs[i].flavorText, str);
+            SS3DS_PgAscii(String_cstr(str), P3DS_PgText[i], sizeof(P3DS_PgText[i]));
+        } else {
+            ReadMsgDataIntoString(data, MapHeader_GetMapSec(sLocationSpecs[i].mapId), str);
+            SS3DS_PgAscii(String_cstr(str), P3DS_PgName[i], sizeof(P3DS_PgName[i]));
+        }
+    }
+    DestroyMsgData(data);
+    return TRUE;
+}
+
+static void SS3DS_PgOnce(void) {
+    static const int kMembers[3] = { 10, 11, 20 };
+    int i;
+    BOOL stringsOk;
+    unsigned started = sceKernelGetSystemTimeLow(), textDone;
+    String *str = String_New(200, HEAP_ID_FIELD1);
+    if (str == NULL) return;
+    stringsOk = SS3DS_PgReadStrings(NARC_msg_msg_0279_bin, FALSE, str) &&
+                SS3DS_PgReadStrings(NARC_msg_msg_0273_bin, TRUE, str);
+    String_Delete(str);
+    if (!stringsOk) return;
+    textDone = sceKernelGetSystemTimeLow();
+""" + s[end:]
+change('    PSPNativeMemLog("[PGMAP] Pokegear map art, map sprites', '''    PSPNativeMemLog("[PGLOAD] text %u us, map and icons %u us", textDone - started, sceKernelGetSystemTimeLow() - textDone);
+    PSPNativeMemLog("[PGMAP] Pokegear map art, map sprites''')
+change("""    u32 secs[100];
+    int m, i, k;
+    for (i = 0; i < 100; i++) secs[i] = MapHeader_GetMapSec(sLocationSpecs[i].mapId);""", """    u32 secs[100];
+    int m, i, k, match;
+    unsigned started = sceKernelGetSystemTimeLow();
+    NARC *events = NARC_New(NARC_fielddata_eventdata_zone_event, HEAP_ID_FIELD1);
+    NARC *encounters = NARC_New(ENCDATA_NARC, HEAP_ID_FIELD1);
+    for (i = 0; i < 100; i++) secs[i] = MapHeader_GetMapSec(sLocationSpecs[i].mapId);""")
+change("""        int bank, any = 0;
+        for (i = 0; i < 100; i++) if (secs[i] == sec) any = 1;
+        if (!any || sec == 0) continue;
+        bank = MapHeader_GetEventsBank(m);
+        if (GetNarcMemberSizeByIdPair(NARC_fielddata_eventdata_zone_event, bank) <= sizeof(sPsEv)) {""", """        int bank, count = 0;
+        u8 locations[100];
+        u32 eventSize;
+        if (sec == 0) continue;
+        for (i = 0; i < 100; i++) if (secs[i] == sec) locations[count++] = (u8)i;
+        if (count == 0) continue;
+        bank = MapHeader_GetEventsBank(m);
+        eventSize = events ? NARC_GetMemberSize(events, bank) : GetNarcMemberSizeByIdPair(NARC_fielddata_eventdata_zone_event, bank);
+        if (eventSize <= sizeof(sPsEv)) {""")
+change("            ReadWholeNarcMemberByIdPair(sPsEv, NARC_fielddata_eventdata_zone_event, bank);", """            if (events) NARC_ReadWholeMember(events, bank, sPsEv);
+            else ReadWholeNarcMemberByIdPair(sPsEv, NARC_fielddata_eventdata_zone_event, bank);""")
+change("""                    for (i = 0; i < 100; i++) if (secs[i] == sec) SS3DS_PsAdd(i, 3,""", """                    for (match = 0; match < count; match++) SS3DS_PsAdd(locations[match], 3,""")
+change("""                for (i = 0; i < 100; i++) if (secs[i] == sec) {
+                    if (sc""", """                for (match = 0; match < count; match++) {
+                    i = locations[match];
+                    if (sc""")
+change("""            WildEncounters_ReadFromNarc(&sPsEnc, m);
+            for (i = 0; i < 100; i++) if (secs[i] == sec) {""", """            if (encounters) {
+                memset(&sPsEnc, 0, sizeof(sPsEnc));
+                NARC_ReadWholeMember(encounters, MapHeader_GetWildEncounterBank(m), &sPsEnc);
+            } else WildEncounters_ReadFromNarc(&sPsEnc, m);
+            for (match = 0; match < count; match++) {
+                i = locations[match];""")
+change('    PSPNativeMemLog("[PGSTAT] read %d trainer/item entries', '''    if (encounters) NARC_Delete(encounters);
+    if (events) NARC_Delete(events);
+    PSPNativeMemLog("[PGLOAD] progress index %u us", sceKernelGetSystemTimeLow() - started);
+    PSPNativeMemLog("[PGSTAT] read %d trainer/item entries''')
+path.write_text(s)
diff --git a/scripts/ss3ds_hooks.d/0276_pgear_load.sh b/scripts/ss3ds_hooks.d/0276_pgear_load.sh
new file mode 100644
index 0000000..bf96b5e
--- /dev/null
+++ b/scripts/ss3ds_hooks.d/0276_pgear_load.sh
@@ -0,0 +1,2 @@
+# Rebuild the field object after the existing Pokegear hooks.
+step ss-pokegear-load bash -c 'cd "$1" && python3 "$2" && bash rebuild_game_object.sh src/field/field_control.c field__field_control.o 1' _ "$C" "$ROOT/scripts/ss3ds_hooks.d/0276_pgear_load.py"
