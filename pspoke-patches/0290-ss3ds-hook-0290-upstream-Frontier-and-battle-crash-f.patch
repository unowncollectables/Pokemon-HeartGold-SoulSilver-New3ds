diff --git a/scripts/ss3ds_hooks.d/0290_upstream_battle.py b/scripts/ss3ds_hooks.d/0290_upstream_battle.py
new file mode 100644
index 0000000..1ab3a8e
--- /dev/null
+++ b/scripts/ss3ds_hooks.d/0290_upstream_battle.py
@@ -0,0 +1,99 @@
+#!/usr/bin/env python3
+"""ss3ds 0290: Battle Frontier + battle crash fixes backported from upstream pspoke (pin 7477648 -> 95a99b0), applied to
+the staged SoulSilver decomp in cwd (= $C). Idempotent: an edit is skipped when its marker is already in the file. Fails
+loudly if an anchor is missing, so a decomp bump that moves the code is noticed. Prints the changed source files, one per
+line, so the .sh rebuilds only those objects.
+
+  pspoke e03aace  Battle Factory: ov80_02236F24's C passed &trainerBuf (one pointer) where ov80_02229F04 fills a 0x30-byte
+                  trainer record; it overran into the saved return address and the first Factory battle jumped to 0.
+  pspoke 7da56e7  Battle Hall: ov80_022375D0's C disagreed with its asm three ways (sub_02051D18 argument order, trainer
+                  record written into the work struct then freed, opponent parties 2/4 instead of 1/3); every Hall battle
+                  crashed in sub_02051D18.
+  pspoke e1e825a  BtlCmd_CalcExpGain divided by the number of party members able to take experience; 0 when the player's
+                  last Pokemon fainted with the foe (Self-Destruct, Explosion). Nobody gains experience: return early.
+"""
+import sys
+
+def sub1(s, old, new, tag):
+    if s.count(old) != 1:
+        sys.exit(f'0290_upstream_battle: {tag}: anchor found {s.count(old)} times (want 1): {old.strip()[:80]}')
+    return s.replace(old, new)
+
+def factory(s):
+    if 'SS3DS 0290 factory' in s:
+        return s
+    s = sub1(s, '    int i;\n    void *trainerBuf;\n',
+             '    int i;\n'
+             '    /* SS3DS 0290 factory (pspoke e03aace): ov80_02229F04 fills a 0x30-byte trainer record here (the asm reserves it on\n'
+             '     * the stack); as one pointer it overran the saved return address and the first Factory battle jumped to 0. */\n'
+             '    u32 trainerBuf[0x30 / 4];\n', 'factory decl')
+    if s.count('ov80_02229F04(&trainerBuf,') != 2 or s.count('ov80_0222A480(setup, &trainerBuf,') != 2:
+        sys.exit('0290_upstream_battle: factory: expected two &trainerBuf call pairs')
+    s = s.replace('ov80_02229F04(&trainerBuf,', 'ov80_02229F04(trainerBuf,')
+    s = s.replace('ov80_0222A480(setup, &trainerBuf,', 'ov80_0222A480(setup, trainerBuf,')
+    return s
+
+def hall(s):
+    if 'SS3DS 0290 hall' in s:
+        return s
+    s = sub1(s, '    int loopCnt;\n    void *trainerBuf;\n',
+             '    int loopCnt;\n'
+             '    /* SS3DS 0290 hall (pspoke 7da56e7): this C (NONMATCHING branch) disagreed with its asm: trainer data is a 0x30-byte\n'
+             '     * stack record, the battle setup call is (setup, NULL, save, mapno, bag, arg5), and the opponent parties are 1 and 3.\n'
+             '     * The Battle Hall crashed in sub_02051D18 starting every battle. */\n'
+             '    u8 trainerData[0x30];\n', 'hall decl')
+    s = sub1(s,
+             '        (FieldSystem *)*(void **)((u8 *)fieldCtx + 8),\n'
+             '        *(SaveData **)((u8 *)fieldCtx + 0x18),\n'
+             '        0,\n'
+             '        (BagCursor *)*(void **)((u8 *)fieldCtx + 0xc),\n',
+             '        NULL,\n'
+             '        *(SaveData **)((u8 *)fieldCtx + 8),\n'
+             '        *(u32 *)((u8 *)fieldCtx + 0x18),\n'
+             '        *(BagCursor **)((u8 *)fieldCtx + 0xc),\n', 'hall setup args')
+    s = sub1(s,
+             '        trainerBuf = (u8 *)work + 0x34;\n'
+             '        ov80_02229F04(trainerBuf, trainerId, 0xb, 0xcc);\n'
+             '        Heap_Free(trainerBuf);\n'
+             '        ov80_0222A480(setup, trainerBuf, sides_b, 1, 0xb);\n',
+             '        Heap_Free(ov80_02229F04(trainerData, trainerId, 0xb, 0xcc));\n'
+             '        ov80_0222A480(setup, trainerData, sides_b, 1, 0xb);\n', 'hall trainer 1')
+    s = sub1(s, '    Party_InitWithMaxSize(setup->party[2], sides_b);\n',
+             '    Party_InitWithMaxSize(setup->party[1], sides_b);\n', 'hall party 1')
+    s = sub1(s,
+             '            trainerBuf = (u8 *)work + 0x34;\n'
+             '            ov80_02229F04(trainerBuf, trainerId3, 0xb, 0xcc);\n'
+             '            Heap_Free(trainerBuf);\n'
+             '            ov80_0222A480(setup, trainerBuf, sides_b, 3, 0xb);\n',
+             '            Heap_Free(ov80_02229F04(trainerData, trainerId3, 0xb, 0xcc));\n'
+             '            ov80_0222A480(setup, trainerData, sides_b, 3, 0xb);\n', 'hall trainer 3')
+    s = sub1(s, '        Party_InitWithMaxSize(setup->party[4], sides_b);\n',
+             '        Party_InitWithMaxSize(setup->party[3], sides_b);\n', 'hall party 3')
+    return s
+
+def exp_gain(s):
+    if 'SS3DS 0290 exp' in s:
+        return s
+    old = ('        totalExp = (totalExp * ctx->battleMons[ctx->battlerIdFainted].level) / 7;\n'
+           '        if (expShareMonsCnt) {\n')
+    return sub1(s, old,
+                '        totalExp = (totalExp * ctx->battleMons[ctx->battlerIdFainted].level) / 7;\n'
+                '        /* SS3DS 0290 exp (pspoke e1e825a): with the player\'s last Pokemon fainted in the same turn (Self-Destruct,\n'
+                '         * Explosion) nobody can take experience and expMonsCnt is 0; do not divide by it. */\n'
+                '        if (expMonsCnt == 0) {\n'
+                '            return FALSE;\n'
+                '        }\n'
+                '        if (expShareMonsCnt) {\n', 'exp guard')
+
+EDITS = [('src/frontier/overlay_80_02236B78.c', factory),
+         ('src/frontier/overlay_80_022372D8.c', hall),
+         ('src/battle/battle_command.c', exp_gain)]
+
+for path, fn in EDITS:
+    with open(path) as f:
+        s = f.read()
+    t = fn(s)
+    if t != s:
+        with open(path, 'w') as f:
+            f.write(t)
+        print(path)
diff --git a/scripts/ss3ds_hooks.d/0290_upstream_battle.sh b/scripts/ss3ds_hooks.d/0290_upstream_battle.sh
new file mode 100644
index 0000000..88ee700
--- /dev/null
+++ b/scripts/ss3ds_hooks.d/0290_upstream_battle.sh
@@ -0,0 +1,13 @@
+# ss3ds 0290: Battle Frontier + battle crash fixes backported from upstream pspoke (Factory first battle, Battle Hall,
+# last Pokemon fainting with the foe). Edits the staged decomp (idempotent) and rebuilds only the objects it changed.
+# A missing anchor stops the build: these are crash fixes, so losing one silently is worse than a clear failure.
+step ss-hook-0290 bash -c "cd '$C' && changed=\$(python3 '$ROOT/scripts/ss3ds_hooks.d/0290_upstream_battle.py') || exit 1
+  for f in \$changed; do
+    case \$f in
+      src/frontier/overlay_80_02236B78.c) bash rebuild_game_object.sh \$f frontier__overlay_80_02236B78.o 80 || exit 1 ;;
+      src/frontier/overlay_80_022372D8.c) bash rebuild_game_object.sh \$f frontier__overlay_80_022372D8.o 80 || exit 1 ;;
+      src/battle/battle_command.c)        bash rebuild_game_object.sh \$f battle__battle_command.o 12 || exit 1 ;;
+      *) echo \"0290: no rebuild rule for \$f\"; exit 1 ;;
+    esac
+  done
+  echo \"0290 rebuilt: \${changed:-nothing (already applied)}\""
