From 20fbcea8d93f31d512dbc2f23a09025f60023847 Mon Sep 17 00:00:00 2001
From: ss3ds <ss3ds@localhost>
Date: Mon, 2 Nov 2026 11:38:02 -0500
Subject: [PATCH 2/2] ss3ds: 0199 strip Mystery Gift cursor diagnostic dumps
 (run 117)

Keep ov74_02235FF8 PlaySE(1500) and gSS_MG_CursorDiag. Remove
[SS-MG-CURSOR] logging from missing.c and ListMenuUpdateCursorObj.
---
 .../nitromain-perf/missing.c                  | 37 ++-------------
 port/soulsilver-native-particles/glue.c       | 45 +------------------
 2 files changed, 4 insertions(+), 78 deletions(-)

diff --git a/port/soulsilver-native-core/nitromain-perf/missing.c b/port/soulsilver-native-core/nitromain-perf/missing.c
index 232b461..562e05a 100644
--- a/port/soulsilver-native-core/nitromain-perf/missing.c
+++ b/port/soulsilver-native-core/nitromain-perf/missing.c
@@ -720,43 +720,12 @@ void CRYPTO_RC4Init(void *ctx,const void *key,unsigned klen){unsigned char *c=ct
  * removed - real DWC_Nd* / CleanupInetAsync / NASLoginAbort wrappers live in
  * soulsilver3ds/platform/ss3ds_dwcstub.c (Mystery Gift WFC download path).
  */
-/* SS3DS run 105: Mystery Gift cursor diagnostic (ListMenu moveCursorFunc). Sets a flag so
- * ListMenuUpdateCursorObj logs palette/OAM/window state only while MG is navigating. */
+/* SS3DS run 105/117: Mystery Gift moveCursorFunc. PlaySE on move; gSS_MG_CursorDiag kept (0192). */
 int gSS_MG_CursorDiag;
-extern void PSPNativeMemLog(const char *, ...);
 extern void PlaySE(unsigned short);
-extern unsigned char s_HW_BG_PLTT[], s_HW_OBJ_PLTT[], s_HW_OAM[];
-extern unsigned char PSPNative_GfxRegisters[];
 void ov74_02235FF8(void *list, int index, unsigned onInit) {
-  unsigned char *l = (unsigned char *)list;
-  unsigned short *bg = (unsigned short *)s_HW_BG_PLTT;
-  unsigned short *obj = (unsigned short *)s_HW_OBJ_PLTT;
-  unsigned short *oam = (unsigned short *)s_HW_OAM;
-  unsigned short *dispcnt = (unsigned short *)(PSPNative_GfxRegisters + 0);
+  (void)list;
+  (void)index;
   gSS_MG_CursorDiag = 1;
-  PSPNativeMemLog("[SS-MG-CURSOR] move list=%p idx=%d onInit=%u cursorPos=%u itemsAbove=%u",
-                  list, index, onInit,
-                  l ? (unsigned)*(unsigned short *)(l + 0x2c) : 0u,
-                  l ? (unsigned)*(unsigned short *)(l + 0x2e) : 0u);
-  if (l) {
-    void *win = *(void **)(l + 0x0c);
-    unsigned short bits = *(unsigned short *)(l + 0x1a);
-    PSPNativeMemLog("[SS-MG-CURSOR] tpl itemX=%u cursorX=%u upY_pal=%02x fill_sh=%02x bits1A=%04x font=%u kind=%u win=%p",
-                    (unsigned)l[0x15], (unsigned)l[0x16], (unsigned)l[0x17], (unsigned)l[0x18],
-                    (unsigned)bits, (unsigned)((bits >> 9) & 0x3f), (unsigned)((bits >> 15) & 1), win);
-    if (win) {
-      unsigned char *w = (unsigned char *)win;
-      PSPNativeMemLog("[SS-MG-CURSOR] win bg=%u left=%u top=%u %ux%u pal=%u base=%u pix=%p",
-                      (unsigned)w[4], (unsigned)w[5], (unsigned)w[6], (unsigned)w[7], (unsigned)w[8],
-                      (unsigned)w[9], (unsigned)(*(unsigned short *)(w + 10) & 0x7fff), *(void **)(w + 12));
-    }
-  }
-  PSPNativeMemLog("[SS-MG-CURSOR] DISPCNT=%04x BG_PLTT[0,1,2,15]=%04x %04x %04x %04x OBJ_PLTT[0,1,2,3]=%04x %04x %04x %04x",
-                  (unsigned)dispcnt[0], (unsigned)bg[0], (unsigned)bg[1], (unsigned)bg[2], (unsigned)bg[15],
-                  (unsigned)obj[0], (unsigned)obj[1], (unsigned)obj[2], (unsigned)obj[3]);
-  PSPNativeMemLog("[SS-MG-CURSOR] OAM0 attr=%04x %04x %04x  OAM1 attr=%04x %04x %04x  OAM2 attr=%04x %04x %04x",
-                  (unsigned)oam[0], (unsigned)oam[1], (unsigned)oam[2],
-                  (unsigned)oam[4], (unsigned)oam[5], (unsigned)oam[6],
-                  (unsigned)oam[8], (unsigned)oam[9], (unsigned)oam[10]);
   if (!onInit) PlaySE(1500); /* SEQ_SE_DP_SELECT */
 }
diff --git a/port/soulsilver-native-particles/glue.c b/port/soulsilver-native-particles/glue.c
index eed9ed1..7415725 100644
--- a/port/soulsilver-native-particles/glue.c
+++ b/port/soulsilver-native-particles/glue.c
@@ -962,50 +962,7 @@ void ListMenuCursorSetColor(struct ListMenuCursor *cursor, u32 color) {
 }
 
 void ListMenuUpdateCursorObj(struct ListMenuCursor *cursor, Window *window, u8 x, u8 y) {
-    /* SS3DS run 105: MG-only cursor diagnostic (flag set by ov74_02235FF8). */
-    extern int gSS_MG_CursorDiag;
-    extern void PSPNativeMemLog(const char *, ...);
-    extern unsigned char s_HW_BG_PLTT[], s_HW_OAM[];
+    /* SS3DS run 117: [SS-MG-CURSOR] dumps removed; draw path unchanged. */
     AddTextPrinterParameterizedWithColor(window, 0, cursor->text, x, y, 0xFF, cursor->color, NULL);
-    if (gSS_MG_CursorDiag) {
-        static int s_n;
-        u16 glyph = 0xFFFF;
-        if (cursor && cursor->text) {
-            const u16 *s = String_cstr(cursor->text);
-            if (s) glyph = s[0];
-        }
-        u32 nonzero = 0, fill = 0xF;
-        if (window && window->pixelBuffer) {
-            /* 4bpp window buffer: count non-fill nibbles in an 8x16 cursor cell at (x,y). */
-            u8 *pix = window->pixelBuffer;
-            /* pixelBuffer is width*height tiles, each tile 32 bytes (8x8 4bpp). */
-            u32 tileW = window->width;
-            for (u32 row = 0; row < 16 && (y + row) / 8u < window->height; row++) {
-                u32 py = y + row;
-                for (u32 col = 0; col < 8 && (x + col) / 8u < tileW; col++) {
-                    u32 px = x + col;
-                    u32 tile = (py / 8) * tileW + (px / 8);
-                    u8 *tp = pix + tile * 32 + (py % 8) * 4 + (px % 8) / 2;
-                    u8 nib = ((px % 8) & 1) ? (*tp >> 4) : (*tp & 0xF);
-                    if (nib != fill) nonzero++;
-                }
-            }
-        }
-        if (s_n < 12) {
-            unsigned short *bg = (unsigned short *)s_HW_BG_PLTT;
-            unsigned short *oam = (unsigned short *)s_HW_OAM;
-            PSPNativeMemLog("[SS-MG-CURSOR] draw n=%d win=%p xy=%u,%u color=%08x glyph=%04x nonzeroPix=%u bgId=%u pal=%u %ux%u",
-                            s_n, (void *)window, (unsigned)x, (unsigned)y, cursor ? cursor->color : 0u,
-                            (unsigned)glyph, nonzero,
-                            window ? (unsigned)window->bgId : 0u,
-                            window ? (unsigned)window->paletteNum : 0u,
-                            window ? (unsigned)window->width : 0u,
-                            window ? (unsigned)window->height : 0u);
-            PSPNativeMemLog("[SS-MG-CURSOR] after-draw BG_PLTT[0,1,2,15]=%04x %04x %04x %04x OAM0=%04x/%04x/%04x",
-                            (unsigned)bg[0], (unsigned)bg[1], (unsigned)bg[2], (unsigned)bg[15],
-                            (unsigned)oam[0], (unsigned)oam[1], (unsigned)oam[2]);
-            s_n++;
-        }
-    }
     CopyWindowPixelsToVram_TextMode(window);
 }
