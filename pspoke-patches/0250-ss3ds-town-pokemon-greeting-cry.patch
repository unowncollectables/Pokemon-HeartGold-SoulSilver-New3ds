-extern BOOL IsCryFinished(void);
-extern void PlaySE(u16 sndseq);
 
 static int sSS3DS_TownMode; // 0223: this frame's tick runs the lively-towns rules (set in SS3DS_WildTick)
 static int SS3DS_Tile(FieldSystem *fieldSystem, int x, int z, int resident) {
@@ -658,21 +675,6 @@ static int SS3DS_WildNapHabit(int sp, const SS3DSTownHabits *habits, int night)
     }
 }
 
