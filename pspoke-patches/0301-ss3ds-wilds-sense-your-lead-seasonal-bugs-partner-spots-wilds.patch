+// 0301: the walking partner's "!" (frames left), drawn above it in SS3DS_WildDraw
+static int sSS3DS_PartnerBang, sSS3DS_PartnerTall = 28; // "!" frames left; its height (read once per sighting, not per frame)
+
+// 0301: the walking partner spots a wild one: a "!" over its head, and it turns to look when the player stands still
+static void SS3DS_PartnerSees(FieldSystem *fieldSystem, const SS3DSWildMon *m, int frames, int turn) {
+    if (!FollowMon_IsVisible(fieldSystem)) {
+        return;
+    }
+    LocalMapObject *f = FollowMon_GetMapObject(fieldSystem);
+    if (f == NULL) {
+        return;
+    }
+    int dx = m->x - (int)MapObject_GetXCoord(f), dz = m->z - (int)MapObject_GetZCoord(f);
+    int adx = dx < 0 ? -dx : dx, adz = dz < 0 ? -dz : dz;
+    if (adx + adz > 7) {
+        return;
+    }
+    if (sSS3DS_PartnerBang <= 0) {
+        sSS3DS_PartnerTall = FollowMon_GetSizeParamBySpecies(FollowMon_GetSpecies(f)) ? 52 : 28; // a small file read: only here
+    }
+    if (sSS3DS_PartnerBang < frames) {
+        sSS3DS_PartnerBang = frames;
+    }
+    if (turn && adx + adz > 0) {
+        MapObject_SetFacingDirection(f, adx > adz ? (dx > 0 ? 3 : 2) : (dz > 0 ? 1 : 0));
+    }
+    PSPNativeMemLog("[WILD] your partner spotted species %d%s", m->sp, turn ? " and turned to look" : "");
+}
