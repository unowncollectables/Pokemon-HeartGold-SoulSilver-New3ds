+// 0301: a wild one sizes up the player's lead (Scarlet/Violet style). A much stronger lead scares it off (never a
+// shiny), a clearly weaker one gets a land one to charge, and the same species as the lead comes over curious.
+static void SS3DS_WildSenseLead(FieldSystem *fieldSystem, SS3DSWildState *S, SS3DSWildMon *m, int i) {
+    if (m->roamer >= 0 || m->big || m->battle || (m->flags & 1)) {
+        return;
+    }
+    int llv = 0, lsp = SS3DS_WildLead(fieldSystem, &llv);
+    if (lsp <= 0 || llv <= 0) {
+        return;
+    }
+    if (lsp == m->sp) {
+        m->mood = 1;
+        m->hop = 16;
+        PSPNativeMemLog("[WILD] slot %d species %d sees one of its own kind with you and comes over", i + 1, m->sp);
+    } else if (!m->shiny && m->mood != 2 && (llv >= m->lv + 25 || (llv >= m->lv + 15 && SS3DS_WildRand(S, 2) == 0))) {
+        m->mood = 2;
+        PSPNativeMemLog("[WILD] slot %d species %d lv %d backs off from your lv %d lead", i + 1, m->sp, m->lv, llv);
+    } else if (m->kind == 1 && m->mood == 0 && m->lv >= llv + 5 && SS3DS_WildRand(S, 2) == 0) {
+        m->mood = 3;
+        PSPNativeMemLog("[WILD] slot %d species %d lv %d sizes up your lv %d lead and charges", i + 1, m->sp, m->lv, llv);
+    }
+}
+
+// 0301: bugs and butterflies for the flyer slot: spring and summer (a few in autumn), clear weather, on routes.
+// The area's own bug flyers first, then a time-of-day pick. 0 = a bird this time.
+static int SS3DS_BugPick(FieldSystem *fieldSystem, SS3DSWildState *S, int env, int ambientWeather) {
+    static const u16 kBug[] = { 12, 15, 49, 165, 166, 193, 267, 269, 284, 313, 314, 414 };
+    static const u16 kMorning[] = { 165, 165, 12, 267, 193 };
+    static const u16 kDayBug[] = { 12, 12, 267, 267, 193, 165, 15 };
+    static const u16 kNightBug[] = { 313, 314, 313, 314, 49, 269 };
+    int map = fieldSystem->location->mapId;
+    if (!MapHeader_IsOutdoors(map) || !MapHeader_HasWildEncounters(map) || (env & 6) || ambientWeather != 0) {
+        return 0;
+    }
+    RTCDate date;
+    RTCTime time;
+    GF_RTC_CopyDateTime(&date, &time);
+    s32 day = RTC_ConvertDateToDay(&date);
+    int season = day < 0 ? 0 : (int)(((u32)day / 7) % 4); // same weeks as SS3DS_SeasonForDay
+    int night = env & 1;
+    u32 odds = season == 3 ? 0 : season == 2 ? 6 : night ? 2 : 3; // 1 in odds
+    if (!odds || SS3DS_WildRand(S, odds) != 0) {
+        return 0;
+    }
+    if (night && season != 1) {
+        return 0; // fireflies (Volbeat / Illumise) only on summer nights
+    }
+    for (int tries = 0; tries < 4; tries++) {
+        int sp, lv;
+        if (!SS3DS_WildPick(fieldSystem, 0, &sp, &lv)) {
+            break;
+        }
+        for (u32 k = 0; k < sizeof(kBug) / sizeof(kBug[0]); k++) {
+            if (kBug[k] == sp) {
+                return sp;
+            }
+        }
+    }
+    if (night) {
+        return kNightBug[SS3DS_WildRand(S, sizeof(kNightBug) / sizeof(kNightBug[0]))];
+    }
+    if (env & WILD_MORNING) {
+        return kMorning[SS3DS_WildRand(S, sizeof(kMorning) / sizeof(kMorning[0]))];
+    }
+    return kDayBug[SS3DS_WildRand(S, sizeof(kDayBug) / sizeof(kDayBug[0]))];
+}
