         c.z += sgn * 12 * FX32_ONE * bank / (SS3DS_BIRD_FRAMES / 2);
     }
+    if (S->birdLow == 2 && !S->birdPerch) { // 0301: a bug zigzags as it goes
+        int wob = (int)(((anim >> 1) + member * 9) & 31);
