+// 0301: the player's lead (first healthy party Pokemon that is not an egg, the walking partner in HGSS): species, or 0
+int SS3DS_WildLead(FieldSystem *fieldSystem, int *level) {
+    Party *party = SaveArray_Party_Get(fieldSystem->saveData);
+    int n = Party_GetCount(party);
+    *level = 0;
+    for (int i = 0; i < n; i++) {
+        Pokemon *mon = Party_GetMonByIndex(party, i);
+        if (GetMonData(mon, MON_DATA_IS_EGG, NULL) || GetMonData(mon, MON_DATA_HP, NULL) == 0) {
+            continue;
+        }
+        *level = (int)GetMonData(mon, MON_DATA_LEVEL, NULL);
+        return (int)GetMonData(mon, MON_DATA_SPECIES, NULL);
+    }
+    return 0;
+}
