From bb331e441da89b76809b7cafd3c4574bf639b09e Mon Sep 17 00:00:00 2001
From: platinum3ds <local@box>
Date: Thu, 29 Oct 2026 19:41:22 -0400
Subject: [PATCH] ss3ds: 0158 0157 hook drops the raw DISPCNT line in the
 staged overlay_58.c

---
 scripts/ss3ds_hooks.d/0157_apricorn_box_ioreg.py | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/scripts/ss3ds_hooks.d/0157_apricorn_box_ioreg.py b/scripts/ss3ds_hooks.d/0157_apricorn_box_ioreg.py
index 993d599..0633da6 100644
--- a/scripts/ss3ds_hooks.d/0157_apricorn_box_ioreg.py
+++ b/scripts/ss3ds_hooks.d/0157_apricorn_box_ioreg.py
@@ -8,9 +8,10 @@ p = 'src/overlay_58.c'
 s = open(p).read()
 if 'SS3DS 0157' in s:
     sys.exit(0)
-old = '    *(u32 *)0x04000000 &= 0xFFFFE0FF;\n    *(u32 *)0x04001000 &= 0xFFFFE0FF;\n'
+old = '    *(u32 *)0x04000000 &= 0xFFFFE0FF;\n'
 if s.count(old) != 1:
     sys.exit('0157_apricorn_box_ioreg: raw DISPCNT anchor not found exactly once')
-s = s.replace(old, '    /* SS3DS 0157: raw DISPCNT writes dropped (native fault); planes and windows are reset by the calls around this */\n')
+s = s.replace(old, '    /* SS3DS 0157: raw 0x04000000 DISPCNT write dropped (native fault) */\n')
+s = s.replace('    *(u32 *)0x04001000 &= 0xFFFFE0FF;\n', '')
 open(p, 'w').write(s)
 print('0157_apricorn_box_ioreg: overlay_58.c patched')
-- 
