From 19114786dfa7dd40749e6d156846791e3186532a Mon Sep 17 00:00:00 2001
From: ss3ds <ss3ds@localhost>
Date: Wed, 18 Nov 2026 20:32:38 +0000
Subject: [PATCH] ss3ds: close the real Wi-Fi Plaza entrance (hook 0285,
 ScrCmd_663)

ScrCmd_663 is the Wi-Fi Plaza entrance (scr_seq_0147_HIROBA); its screens (overlays 45, 49, 91 to 93) are still [SS-MISSING], so entering aborted. It now returns without starting anything (the command's own no-connection path), shows the toast WI-FI PLAZA IS CLOSED and logs one [WIFI] line. 0274 actually closed ScrCmd_662, the Global Terminal data counters, not the Plaza; this hook also renames that toast to TERMINAL COUNTERS CLOSED (0274 is not edited in place). Optional hook; logs skipped on failure. Not compiled or run on device.
---
 scripts/ss3ds_hooks.d/0285_plaza_closed.py | 35 ++++++++++++++++++++++
 scripts/ss3ds_hooks.d/0285_plaza_closed.sh |  4 +++
 2 files changed, 39 insertions(+)
 create mode 100644 scripts/ss3ds_hooks.d/0285_plaza_closed.py
 create mode 100644 scripts/ss3ds_hooks.d/0285_plaza_closed.sh

diff --git a/scripts/ss3ds_hooks.d/0285_plaza_closed.py b/scripts/ss3ds_hooks.d/0285_plaza_closed.py
new file mode 100644
index 0000000..dbd6a2d
--- /dev/null
+++ b/scripts/ss3ds_hooks.d/0285_plaza_closed.py
@@ -0,0 +1,35 @@
+#!/usr/bin/env python3
+"""ss3ds 0285: close the real Wi-Fi Plaza entrance and fix the toast of 0274.
+ScrCmd_663 (src/scrcmd_c.c) is the Wi-Fi Plaza entrance (scr_seq_0147_HIROBA, scr_seq_0164): it starts sub_02056D00, whose screens
+(overlays 45, 49, minigames 91 to 93) are still [SS-MISSING] traps, so walking into the Plaza aborted the game. It now does what the
+command already does when the Wi-Fi check fails (returns without starting anything, the script carries on), shows the toast
+"WI-FI PLAZA IS CLOSED" and logs one [WIFI] line.
+0274 closed ScrCmd_662, which is NOT the Plaza but the Goldenrod Global Terminal data counters (rankings, battle videos, box data,
+dress-up; the GTS desk is a different path and keeps working). Its toast is renamed to "TERMINAL COUNTERS CLOSED" here, because
+0274 is already applied and is never edited in place.
+Idempotent ('SS3DS 0285'); applied to the staged decomp's src/scrcmd_c.c in cwd (= $C)."""
+import sys
+p = 'src/scrcmd_c.c'
+s = open(p).read()
+if 'SS3DS 0285' in s:
+    sys.exit(0)
+old = ('    u16 *p_var = ScriptGetVarPointer(ctx);\n'
+       '    if (sub_0203A05C(ctx->fieldSystem->saveData)) {\n'
+       '        sub_02056D00(ctx->taskman, *p_var);\n')
+if s.count(old) != 1:
+    sys.exit('0285_plaza_closed: ScrCmd_663 pattern missing in ' + p)
+new = ('    u16 *p_var = ScriptGetVarPointer(ctx);\n'
+       '    extern void P3DS_Toast(const char *); /* SS3DS 0285 */\n'
+       '    extern void PSPNativeMemLog(const char *fmt, ...);\n'
+       '    if (1) {\n'
+       '        (void)p_var;\n'
+       '        PSPNativeMemLog("[WIFI] ScrCmd_663 (Wi-Fi Plaza entrance) refused: overlays 45/49/91-93 are not ported");\n'
+       '        P3DS_Toast("WI-FI PLAZA IS CLOSED");\n'
+       '    } else if (sub_0203A05C(ctx->fieldSystem->saveData)) {\n'
+       '        sub_02056D00(ctx->taskman, *p_var);\n')
+s = s.replace(old, new)
+# 0274 closed ScrCmd_662 (Global Terminal counters): give its toast and log line the right name. Skipped quietly when 0274 is absent.
+s = s.replace('P3DS_Toast("WI-FI PLAZA IS CLOSED");\n        *p_ret = 0;', 'P3DS_Toast("TERMINAL COUNTERS CLOSED");\n        *p_ret = 0;')
+s = s.replace('[WIFI] ScrCmd_662 (Wi-Fi Plaza entrance) refused: overlays 39/45 are not ported', '[WIFI] ScrCmd_662 (Global Terminal counters) refused: overlay 39 is not ported')
+open(p, 'w').write(s)
+print('0285_plaza_closed: scrcmd_c.c ScrCmd_663 closed')
diff --git a/scripts/ss3ds_hooks.d/0285_plaza_closed.sh b/scripts/ss3ds_hooks.d/0285_plaza_closed.sh
new file mode 100644
index 0000000..bb3521d
--- /dev/null
+++ b/scripts/ss3ds_hooks.d/0285_plaza_closed.sh
@@ -0,0 +1,4 @@
+# ss3ds 0285: Wi-Fi Plaza entrance closed (ScrCmd_663 in scrcmd_c.c); also renames the 0274 toast. Optional: without it the Plaza entrance still aborts on [SS-MISSING].
+if ! (cd "$C" && python3 "$ROOT/scripts/ss3ds_hooks.d/0285_plaza_closed.py" && bash rebuild_game_object.sh src/scrcmd_c.c scrcmd_c.o none); then
+  log "ss3ds 0285 plaza closed hook skipped (see message above); the Wi-Fi Plaza entrance still aborts"
+fi
