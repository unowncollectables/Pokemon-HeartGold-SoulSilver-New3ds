From 952f28065ab056548d92e14d80dc416dc62c48ed Mon Sep 17 00:00:00 2001
From: ss3ds <ss3ds@localhost>
Date: Wed, 18 Nov 2026 23:33:02 +0000
Subject: [PATCH] ss3ds: hook 0289 sharp game text (bg_window.c text pixel
 recording for the native text layers)

---
 scripts/ss3ds_hooks.d/0289_gametext.py | 85 ++++++++++++++++++++++++++
 scripts/ss3ds_hooks.d/0289_gametext.sh |  4 ++
 2 files changed, 89 insertions(+)
 create mode 100644 scripts/ss3ds_hooks.d/0289_gametext.py
 create mode 100644 scripts/ss3ds_hooks.d/0289_gametext.sh

diff --git a/scripts/ss3ds_hooks.d/0289_gametext.py b/scripts/ss3ds_hooks.d/0289_gametext.py
new file mode 100644
index 0000000..625022c
--- /dev/null
+++ b/scripts/ss3ds_hooks.d/0289_gametext.py
@@ -0,0 +1,85 @@
+#!/usr/bin/env python3
+"""ss3ds 0289 sharp game text: bg_window.c tells the platform (soulsilver3ds/platform/ss3ds_gametext.c) which pixels every glyph
+changes in a text window (and what was under them), and the platform hands back a copy of the window's pixels WITHOUT that text for
+the VRAM upload (the window's own buffer is never changed, so everything that reads it still sees the text), then is told where the
+copy went. The platform draws the text at the screen's own resolution, on both screens. Applied to the staged SoulSilver decomp in cwd (= $C). Idempotent ('SS3DS 0289'); fails loudly if an anchor moved.
+Setting off / window not eligible: every call returns at once and the game behaves exactly as before."""
+import sys
+p = 'src/bg_window.c'
+s = open(p).read()
+if 'SS3DS 0289' in s:
+    sys.exit(0)
+
+def sub(old, new, count=1):
+    global s
+    if s.count(old) != count:
+        sys.exit('0289_gametext: anchor not found %d time(s): %r' % (count, old[:70]))
+    s = s.replace(old, new)
+
+# 1. declarations, after the first include block
+inc = '#include "bg_window.h"\n'
+sub(inc, inc + '''
+/* SS3DS 0289: sharp game text hooks (soulsilver3ds/platform/ss3ds_gametext.c) */
+typedef struct { const void *buf; int bg, left, top, wT, hT, pal, base, is4bpp; } P3DS_GtDesc;
+extern int P3DS_GtWant(const P3DS_GtDesc *d);
+extern void P3DS_GtPre(const P3DS_GtDesc *d, int x, int y);
+extern void P3DS_GtPost(const P3DS_GtDesc *d, int x, int y);
+extern void P3DS_GtLoaded(const P3DS_GtDesc *d, const void *vram, unsigned size);
+extern void P3DS_GtFill(const P3DS_GtDesc *d, int fillValue);
+extern void P3DS_GtRect(const P3DS_GtDesc *d, int x, int y, int w, int h);
+extern void P3DS_GtScroll(const P3DS_GtDesc *d, int dir, int amount, int fillValue);
+extern void P3DS_GtRemove(const void *buf);
+extern const void *P3DS_GtUpload(const P3DS_GtDesc *d, unsigned size);
+static void SS3DS_GtD(const Window *w, P3DS_GtDesc *d) {
+    d->buf = w->pixelBuffer; d->bg = w->bgId; d->left = w->tilemapLeft; d->top = w->tilemapTop; d->wT = w->width; d->hT = w->height;
+    d->pal = w->paletteNum; d->base = w->baseTile; d->is4bpp = (w->bgConfig != NULL && w->colorMode == GF_BG_CLR_4BPP) ? 1 : 0;
+}
+''', 1)
+
+# 2. RemoveWindow / WindowArray_Delete: forget the window
+sub('void RemoveWindow(Window *window) {\n    Heap_Free(window->pixelBuffer);\n',
+    'void RemoveWindow(Window *window) {\n    P3DS_GtRemove(window->pixelBuffer); /* SS3DS 0289 */\n    Heap_Free(window->pixelBuffer);\n')
+sub('        if (windows[i].pixelBuffer != NULL) {\n            Heap_Free(windows[i].pixelBuffer);',
+    '        if (windows[i].pixelBuffer != NULL) {\n            P3DS_GtRemove(windows[i].pixelBuffer); /* SS3DS 0289 */\n            Heap_Free(windows[i].pixelBuffer);')
+
+# 3. the upload: the platform decides which buffer goes to VRAM
+sub('void CopyWindowPixelsToVram_TextMode(Window *window) {\n    BG_LoadCharTilesData(window->bgConfig, window->bgId, window->pixelBuffer, window->width * window->height * window->bgConfig->bgs[window->bgId].tileSize, window->baseTile);\n}',
+    'void CopyWindowPixelsToVram_TextMode(Window *window) {\n    /* SS3DS 0289: the platform may return a copy without the glyphs it draws natively */\n    P3DS_GtDesc gtd; SS3DS_GtD(window, &gtd);\n    const unsigned gtSize = window->width * window->height * window->bgConfig->bgs[window->bgId].tileSize;\n    const void *gtSrc = window->bgConfig->bgs[window->bgId].tileSize == TILE_SIZE_4BPP ? P3DS_GtUpload(&gtd, gtSize) : window->pixelBuffer;\n    BG_LoadCharTilesData(window->bgConfig, window->bgId, gtSrc, gtSize, window->baseTile);\n    if (window->bgConfig->bgs[window->bgId].tileSize == TILE_SIZE_4BPP) {\n        P3DS_GtLoaded(&gtd, (const u8 *)BgGetCharPtr(window->bgId) + window->baseTile * TILE_SIZE_4BPP, gtSize);\n    }\n}')
+
+# 4. fills: a full fill makes the window "one colour"
+sub('void FillWindowPixelBuffer(Window *window, u8 fillValue) {\n',
+    'void FillWindowPixelBuffer(Window *window, u8 fillValue) {\n    { P3DS_GtDesc gtd; SS3DS_GtD(window, &gtd); P3DS_GtFill(&gtd, fillValue); } /* SS3DS 0289 */\n')
+sub('void FillWindowPixelBufferText_AssumeTileSize32(Window *window, u8 fillValue) {\n',
+    'void FillWindowPixelBufferText_AssumeTileSize32(Window *window, u8 fillValue) {\n    { P3DS_GtDesc gtd; SS3DS_GtD(window, &gtd); P3DS_GtFill(&gtd, fillValue); } /* SS3DS 0289 */\n')
+
+# 5. other writers: glyphs under the rectangle are forgotten (only glyph pixels are ever erased)
+sub('void FillWindowPixelRect(Window *window, u8 fillValue, u16 x, u16 y, u16 width, u16 height) {\n    Bitmap bmp;\n',
+    'void FillWindowPixelRect(Window *window, u8 fillValue, u16 x, u16 y, u16 width, u16 height) {\n    Bitmap bmp;\n    { P3DS_GtDesc gtd; SS3DS_GtD(window, &gtd); P3DS_GtRect(&gtd, x, y, width, height); } /* SS3DS 0289 */\n')
+sub('void BlitBitmapRect(Window *window, void *src, u16 srcX, u16 srcY, u16 srcWidth, u16 srcHeight, u16 destX, u16 destY, u16 destWidth, u16 destHeight, u16 colorKey) {\n    Bitmap bmpSrc, bmpDest;\n',
+    'void BlitBitmapRect(Window *window, void *src, u16 srcX, u16 srcY, u16 srcWidth, u16 srcHeight, u16 destX, u16 destY, u16 destWidth, u16 destHeight, u16 colorKey) {\n    Bitmap bmpSrc, bmpDest;\n    { P3DS_GtDesc gtd; SS3DS_GtD(window, &gtd); P3DS_GtRect(&gtd, destX, destY, destWidth, destHeight); } /* SS3DS 0289 */\n')
+sub('void ScrollWindow(Window *window, u8 direction, u8 y, u8 fillValue) {\n',
+    'void ScrollWindow(Window *window, u8 direction, u8 y, u8 fillValue) {\n    { P3DS_GtDesc gtd; SS3DS_GtD(window, &gtd); P3DS_GtScroll(&gtd, direction, y, fillValue); } /* SS3DS 0289 */\n')
+
+# 6. the glyph copy: the original becomes static; the wrapper notes the 16x32 cell before and after it, so the platform knows
+#    exactly which pixels the glyph changed (with the row doubling and clipping the game gives it) and what was under them
+old = 'void CopyGlyphToWindow(Window *window, u8 *glyphPixels, u16 srcWidth, u16 srcHeight, u16 destX, u16 destY, u16 table) {\n'
+new = '''static void CopyGlyphToWindow_ss3ds_orig(Window *window, u8 *glyphPixels, u16 srcWidth, u16 srcHeight, u16 destX, u16 destY, u16 table);
+void CopyGlyphToWindow(Window *window, u8 *glyphPixels, u16 srcWidth, u16 srcHeight, u16 destX, u16 destY, u16 table) {
+    /* SS3DS 0289 */
+    P3DS_GtDesc gtd;
+    int gtWant;
+    SS3DS_GtD(window, &gtd);
+    gtWant = P3DS_GtWant(&gtd);
+    if (gtWant) {
+        P3DS_GtPre(&gtd, destX, destY);
+    }
+    CopyGlyphToWindow_ss3ds_orig(window, glyphPixels, srcWidth, srcHeight, destX, destY, table);
+    if (gtWant) {
+        P3DS_GtPost(&gtd, destX, destY);
+    }
+}
+static void CopyGlyphToWindow_ss3ds_orig(Window *window, u8 *glyphPixels, u16 srcWidth, u16 srcHeight, u16 destX, u16 destY, u16 table) {
+'''
+sub(old, new)
+open(p, 'w').write(s)
+print('0289_gametext: bg_window.c hooked')
diff --git a/scripts/ss3ds_hooks.d/0289_gametext.sh b/scripts/ss3ds_hooks.d/0289_gametext.sh
new file mode 100644
index 0000000..53e0297
--- /dev/null
+++ b/scripts/ss3ds_hooks.d/0289_gametext.sh
@@ -0,0 +1,4 @@
+# ss3ds 0289: sharp game text hooks in bg_window.c (soulsilver3ds/platform/ss3ds_gametext.c). Not fatal: without it all game text stays in the DS picture.
+if ! (cd "$C" && python3 "$ROOT/scripts/ss3ds_hooks.d/0289_gametext.py" && bash rebuild_game_object.sh src/bg_window.c bg_window.o none); then
+  log "ss3ds 0289 sharp game text hooks NOT applied (see message above); game text stays in the DS picture"
+fi
-- 
