         for (i = 0; i < SS3DS_WILD_MAX; i++) {
             SS3DS_WildKill(S, i, "off");
         }
         SS3DS_BirdKill(S, "off");
-        SS3DS_TownShower(fieldSystem, S, 0, 0);
+        if (!seasonal) {
+            SS3DS_TownShower(fieldSystem, S, 0, 0);
+        }
         SS3DS_TownClerkRemove(fieldSystem, S);
         S->talk = 0;
         return;
@@ -1424,10 +1570,15 @@ static void SS3DS_WildTick(FieldSystem *fieldSystem) {
