     const SS3DSTownRoutine *routine = link ? SS3DS_TownRoutineForMap(map, env, &indoors) : NULL;
@@ -2577,6 +2728,14 @@ if which in ('all', 'field'):
     s = open(p).read()
     proto = 'static void SS3DS_WildTick(FieldSystem *fieldSystem); // SS3DS 0112: defined in the 0110 block below\nstatic void SS3DS_WildDraw(FieldSystem *fieldSystem);\n'
     main = 'BOOL FieldMap_Main(OverlayManager *man, int *state) {\n'
+    weather_call = '    WeatherManager_ChangeWeather(fieldSystem->unk4->weatherManager, LocalFieldData_GetWeatherType(localFieldData));'
+    connected_weather = '    WeatherManager_ChangeWeather(fieldSystem->unk4->weatherManager, SS3DS_ConnectedRenderWeather(fieldSystem, newMapID, LocalFieldData_GetWeatherType(localFieldData)));'
+    weather_proto = 'static int SS3DS_ConnectedRenderWeather(FieldSystem *fieldSystem, int map, int native);\n'
