+static BOOL SS3DS_SeasonHighland(int map) {
+    switch (map) {
+    case MAP_MAHOGANY:
+    case MAP_LAKE_OF_RAGE:
+    case MAP_BLACKTHORN:
+    case MAP_ROUTE_42:
+    case MAP_ROUTE_43:
+    case MAP_ROUTE_44:
+    case MAP_ROUTE_45:
+        return TRUE;
+    default:
+        return FALSE;
+    }
+}
+
+enum { SEASON_SPRING, SEASON_SUMMER, SEASON_AUTUMN, SEASON_WINTER };
+
+static int SS3DS_SeasonForDay(u32 day) {
+    return (day / 7) % 4;
+}
+
+// One roll per region and three-hour window. Elevation can change the form
+// of precipitation while the surrounding lowlands share the same front.
+static int SS3DS_SeasonWeather(u32 region, BOOL highland, u32 day, int hour) {
+    u32 window = day * 8u + hour / 3;
+    u32 roll = window ^ (region * 0x9e3779b9u);
+    roll ^= roll >> 16;
+    roll *= 0x7feb352du;
+    roll ^= roll >> 15;
+    roll *= 0x846ca68bu;
+    roll ^= roll >> 16;
+    roll %= 100;
+    switch (SS3DS_SeasonForDay(day)) {
+    case SEASON_SPRING:
+        return roll < 25 ? WEATHER_RAIN : WEATHER_SUNNY;
+    case SEASON_SUMMER:
+        return roll < 12 ? WEATHER_RAIN : WEATHER_SUNNY;
+    case SEASON_AUTUMN:
+        if (roll < 12 && (hour < 9 || hour >= 18)) {
+            return WEATHER_UNKNOWN_9; // Native mist
+        }
+        return roll >= 12 && roll < 20 ? WEATHER_RAIN : WEATHER_SUNNY;
+    default:
+        if (roll < (highland ? 26 : 8)) {
+            return WEATHER_SNOW;
+        }
+        return roll < 18 ? WEATHER_RAIN : WEATHER_SUNNY;
+    }
+}
+
+extern int P3DS_AmbientWeatherCfg(void);
+
+static int SS3DS_AmbientForecast(int map) {
+    MapType type = MapHeader_GetMapType(map);
+    if ((type != MAP_TYPE_CITY_TOWN && type != MAP_TYPE_ROUTE) || !MapHeader_IsOutdoors(map)) {
+        return WEATHER_SUNNY;
+    }
+    RTCDate date;
+    RTCTime time;
+    GF_RTC_CopyDateTime(&date, &time);
+    s32 day = RTC_ConvertDateToDay(&date);
+    if (day < 0 || time.hour >= 24) {
+        return WEATHER_SUNNY;
+    }
+    static int lastSeason = -1;
+    static const char *const names[] = { "spring", "summer", "autumn", "winter" };
+    int season = SS3DS_SeasonForDay((u32)day);
+    if (season != lastSeason) {
+        PSPNativeMemLog("[WEATHER] season %s", names[season]);
+        lastSeason = season;
+    }
+    return SS3DS_SeasonWeather(MapHeader_GetRegionNo(map), SS3DS_SeasonHighland(map), (u32)day, time.hour);
+}
+
+// Map connections reuse the manager. Pass the destination forecast into the
+// original transition call so shared weather does not briefly clear.
+static int SS3DS_ConnectedRenderWeather(FieldSystem *fieldSystem, int map, int native) {
+    if (native != WEATHER_SUNNY || !P3DS_AmbientWeatherCfg() || FieldSystem_TaskIsRunning(fieldSystem)) {
+        return native;
+    }
+    return SS3DS_AmbientForecast(map);
+}
+
+static int SS3DS_SeasonWeatherTick(FieldSystem *fieldSystem, int enabled, int townShower) {
+    static int refresh, lastMap = -1, wasEnabled, forecast, requested, restoring;
+    static void *lastManager;
+    if (fieldSystem->location == NULL || fieldSystem->unk4 == NULL || fieldSystem->unk4->weatherManager == NULL) {
+        return 0;
+    }
+    if (FieldSystem_TaskIsRunning(fieldSystem)) {
+        return 0;
+    }
+    int map = fieldSystem->location->mapId;
+    void *manager = fieldSystem->unk4->weatherManager;
+    int entered = manager != lastManager || map != lastMap;
+    if (entered) {
+        requested = WEATHER_SUNNY;
+        restoring = 0;
+    }
+    int sample = entered || refresh == 0 || enabled != wasEnabled;
+    if (sample) {
+        forecast = enabled ? SS3DS_AmbientForecast(map) : WEATHER_SUNNY;
+        refresh = 60;
+    }
+    refresh--;
+    wasEnabled = enabled;
+    lastMap = map;
+    lastManager = manager;
+    if (!enabled && !requested && !restoring) {
+        return 0;
+    }
+    int native = LocalFieldData_GetWeatherType(Save_LocalFieldData_Get(fieldSystem->saveData));
+    if (native != WEATHER_SUNNY) {
+        requested = WEATHER_SUNNY;
+        restoring = 0;
+        return 0;
+    }
+    int desired = forecast;
+    int current = ov01_021EB31C(manager);
+    if (desired != requested || (enabled && townShower && !entered)) {
+        WeatherManager_ChangeWeather(manager, desired);
+        restoring = desired == WEATHER_SUNNY;
+        requested = desired;
+        PSPNativeMemLog("[WEATHER] map %d ambient %d", map, desired);
+    } else if ((desired || restoring) && sample) {
+        if (current != desired) {
+            WeatherManager_ChangeWeather(manager, desired);
+        } else {
+            restoring = 0;
+        }
+    }
+    // The weather transition is asynchronous. Let residents react once the
+    // native manager reports the visible condition.
+    if ((requested || restoring) && (current == WEATHER_RAIN || current == WEATHER_SNOW || current == WEATHER_UNKNOWN_9)) {
+        return current;
+    }
+    return WEATHER_SUNNY;
+}
+
 static void SS3DS_WildTick(FieldSystem *fieldSystem) {
     SS3DSWildState *S = SS3DS_WildGet();
