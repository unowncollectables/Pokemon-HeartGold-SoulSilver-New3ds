; ss3ds fps60: the G3 passthrough with one 4x4 matrix in front of the position (in-between pictures: last tick's
; clip coordinates carried halfway to this tick's, per draw call; g3gpu.c sets kmtx)
; stereok.x matches g3.v.pica (shared-left stereo right eye).
.fvec kmtx[4]
.fvec stereok
.out outpos position
.out outtc0 texcoord0
.out outclr color
.alias inpos v0
.alias intc v1
.alias inclr v2
.proc main
	dp4 r0.x, kmtx[0], inpos
	dp4 r0.y, kmtx[1], inpos
	dp4 r0.z, kmtx[2], inpos
	dp4 r0.w, kmtx[3], inpos
	mul r1.x, intc.z, r0.w
	mad outpos.x, r1.x, stereok.x, r0.x
	mov outpos.yzw, r0.yzw
	mov outtc0, intc
	mov outclr, inclr
	end
.end
