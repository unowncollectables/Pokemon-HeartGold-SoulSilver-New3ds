; Apply the eye shift before K, as in CPU stereo expand followed by g3k.
.fvec stereok
.fvec kmtx[4]
.out outpos position
.out outtc0 texcoord0
.out outclr color
.alias inpos v0
.alias intc v1
.alias inclr v2
.alias indsh v3
.proc main
	mov r5, inpos
	mul r6.xyzw, indsh.xxxx, r5.wwww
	mad r5.x, r6.x, stereok.x, r5.x
	dp4 outpos.x, kmtx[0], r5
	dp4 outpos.y, kmtx[1], r5
	dp4 outpos.z, kmtx[2], r5
	dp4 outpos.w, kmtx[3], r5
	mov outtc0, intc
	mov outclr, inclr
	end
.end
